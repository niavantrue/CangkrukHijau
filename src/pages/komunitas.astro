---
import Layout from '../layouts/Layout.astro';
import CommunityCard from '../components/CommunityCard.astro';
import { communities } from '../data/komunitas.js';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

const joinedCommunityIds = new Set<string>();

if (user && supabase) {
  try {
    const { data: userComms } = await supabase
      .from('user_communities')
      .select('community_id')
      .eq('user_id', user.id);

    if (userComms) {
      userComms.forEach((c: { community_id: string }) => joinedCommunityIds.add(c.community_id));
    }
  } catch (err) {
    // Graceful fallback
  }
}
---

<Layout
  title="Komunitas | Cangkruk Hijau"
  description="Temukan dan daftarkan komunitas lingkungan di Surabaya yang aktif dalam pengelolaan sampah, ruang hijau, dan aksi konservasi."
  activeNav="komunitas"
  lang="id"
>
  <div class="hero">
    <div class="wrap">
      <div style="margin-bottom: 14px;">
        <a class="back" href="/">← Kembali ke Beranda</a>
      </div>
      <div class="eyebrow">Komunitas peduli lingkungan</div>
      <h1 class="title">Temukan komunitas lingkungan di Surabaya</h1>
      <p class="lead">
        Jelajahi referensi komunitas lingkungan di Surabaya yang aktif dalam pengelolaan sampah, ruang hijau, konservasi, edukasi, dan aksi komunitas.
      </p>
      <div class="stats">
        <div class="stat"><strong>{communities.length}</strong><span>referensi komunitas</span></div>
        <div class="stat"><strong>5+</strong><span>jenis aksi lingkungan</span></div>
        <div class="stat"><strong>24/7</strong><span>siap bergabung</span></div>
      </div>
    </div>
  </div>

  <main class="content">
    <div class="wrap">
      <div id="toastNotification" class="toast-notice hide"></div>

      <div class="form-grid">
        <!-- List Komunitas dengan Pencarian & Pagination -->
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
            <div>
              <h2 style="font-size: 24px; color: var(--g700);">Daftar Komunitas</h2>
              <p id="paginationInfo" style="font-size: 13.5px; color: var(--muted); margin-top: 2px;">
                Menampilkan 1-8 dari {communities.length} komunitas
              </p>
            </div>
            {user && (
              <a href="/komunitas-saya" class="slink">
                Lihat Komunitas Saya ({joinedCommunityIds.size}) →
              </a>
            )}
          </div>

          <!-- Filter / Search Bar -->
          <div class="comm-toolbar">
            <div class="search-wrap">
              <input
                id="searchCommunityInput"
                type="text"
                placeholder="Cari nama komunitas, fokus, atau lokasi..."
                class="comm-search"
                autocomplete="off"
              />
            </div>
          </div>

          <div class="list" id="communityCardsList" style="display: grid; gap: 18px;">
            {communities.map((item, index) => (
              <div class="community-card-wrapper" data-index={index} data-name={item.name.toLowerCase()} data-scope={item.scope.toLowerCase()} data-desc={item.description.toLowerCase()}>
                <CommunityCard
                  id={item.id}
                  name={item.name}
                  logo={item.logo}
                  badge={item.badge}
                  scope={item.scope}
                  description={item.description}
                  address={item.address}
                  contacts={item.contacts as any}
                  variant="detailed"
                  isJoined={joinedCommunityIds.has(item.id)}
                />
              </div>
            ))}
          </div>

          <div id="noCommunityFound" class="panel hide" style="text-align: center; padding: 40px 20px; margin-top: 18px; border: 1px dashed var(--line);">
            <div style="font-size: 36px; margin-bottom: 8px;">🔍</div>
            <h3 style="color: var(--g900); font-size: 18px;">Komunitas Tidak Ditemukan</h3>
            <p style="color: var(--muted); font-size: 14px; margin-top: 4px;">
              Coba gunakan kata kunci pencarian yang berbeda atau daftarkan komunitas baru melalui formulir di samping.
            </p>
          </div>

          <!-- Pagination Controls -->
          <div class="pagination-bar" id="paginationControls">
            <button type="button" class="btn-page-nav" id="prevPageBtn" disabled>
              ← Sebelumnya
            </button>
            <div class="page-numbers" id="pageNumberButtons"></div>
            <button type="button" class="btn-page-nav" id="nextPageBtn">
              Berikutnya →
            </button>
          </div>
        </div>

        <!-- Form Pendaftaran Komunitas Baru -->
        <div>
          <div class="form-panel" id="daftarKomunitas">
            <div class="form-header">
              <div class="form-title">Daftarkan Komunitas</div>
              <span class="badge visi">Gratis</span>
            </div>
            <p style="font-size: 13.5px; color: var(--muted); margin-bottom: 16px;">
              Punya komunitas atau ingin mengusulkan aksi lingkungan baru di Surabaya? Daftarkan di sini agar terhubung dengan relawan lain.
            </p>

            <form id="daftarKomunitasForm" class="form-box">
              <div>
                <label for="namaKomunitas">Nama Komunitas</label>
                <input id="namaKomunitas" name="namaKomunitas" type="text" placeholder="Contoh: Green Heroes SBY" required />
              </div>
              <div>
                <label for="fokus">Fokus Gerakan</label>
                <select id="fokus" name="fokus" required>
                  <option value="">Pilih Fokus Gerakan</option>
                  <option value="Sampah & Daur Ulang">Pengelolaan Sampah & Daur Ulang</option>
                  <option value="Ruang Hijau & Pohon">Penanaman Pohon & Ruang Hijau</option>
                  <option value="Sungai & Pesisir">Kebersihan Sungai & Pesisir</option>
                  <option value="Edukasi & Advokasi">Edukasi & Advokasi Kebijakan</option>
                  <option value="Energi & Iklim">Transisi Energi & Aksi Iklim</option>
                </select>
              </div>
              <div>
                <label for="alamat">Alamat / Wilayah Aksi</label>
                <input id="alamat" name="alamat" type="text" placeholder="Kecamatan atau Kota" required />
              </div>
              <div>
                <label for="kontak">Kontak WhatsApp / Email</label>
                <input id="kontak" name="kontak" type="text" placeholder="08... atau email@domain.com" required />
              </div>
              <div>
                <label for="deskripsi">Deskripsi Singkat</label>
                <textarea id="deskripsi" name="deskripsi" placeholder="Ceritakan misi dan kegiatan rutin komunitas..." required></textarea>
              </div>
              <button class="submit" type="submit">Kirim Pendaftaran</button>
              <div id="formFeedback" class="notice hide" style="color: var(--g700); font-weight: 700;">
                Terima kasih! Data komunitas Anda berhasil dikirim dan akan diverifikasi.
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <style>
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-top: 22px;
    }
    .stat {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 16px 18px;
    }
    .stat strong {
      display: block;
      color: var(--green);
      font-size: 28px;
      font-family: var(--logo);
    }
    .stat span {
      font-size: 13px;
      color: var(--muted);
      font-weight: 700;
    }
    .content {
      padding: 24px 0 70px;
    }
    .comm-toolbar {
      margin-bottom: 20px;
    }
    .comm-search {
      width: 100%;
      padding: 12px 18px;
      border: 1px solid var(--line);
      border-radius: 12px;
      font-family: var(--sans);
      font-size: 14.5px;
      background: #fff;
      color: var(--text);
      box-shadow: var(--shadow);
    }
    .comm-search:focus {
      outline: 2px solid var(--g700);
    }
    .form-panel {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 22px;
      padding: 22px;
      box-shadow: var(--shadow);
      position: sticky;
      top: 95px;
    }
    .form-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }
    .form-title {
      font-size: 24px;
      font-weight: 800;
      color: var(--green);
      font-family: var(--logo);
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 24px;
      align-items: start;
    }
    .form-box {
      display: grid;
      gap: 16px;
    }

    /* Pagination Styles */
    .pagination-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 32px;
      flex-wrap: wrap;
    }
    .btn-page-nav {
      background: #fff;
      border: 1px solid var(--line);
      color: var(--text);
      font-weight: 700;
      font-size: 13.5px;
      padding: 9px 16px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-page-nav:hover:not(:disabled) {
      background: var(--g700);
      color: #fff;
      border-color: var(--g700);
    }
    .btn-page-nav:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .page-numbers {
      display: flex;
      gap: 6px;
    }
    :global(.page-num-btn) {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--text);
      font-weight: 700;
      font-size: 13.5px;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: all 0.15s;
    }
    :global(.page-num-btn.active) {
      background: var(--g700);
      color: #fff;
      border-color: var(--g700);
    }
    :global(.page-num-btn:hover:not(.active)) {
      background: var(--g100);
    }

    .toast-notice {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 1000;
      padding: 14px 20px;
      border-radius: 12px;
      background: var(--g900);
      color: #fff;
      font-weight: 600;
      font-size: 14px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
      transition: opacity 0.3s;
    }
    @media (max-width: 980px) {
      .form-grid {
        grid-template-columns: 1fr;
      }
      .form-panel {
        position: static;
      }
    }
    @media (max-width: 640px) {
      .stats {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script define:vars={{ isLoggedIn: !!user }}>
    const toast = document.getElementById('toastNotification');

    function showToast(message, isError = false) {
      if (!toast) return;
      toast.textContent = message;
      toast.style.background = isError ? '#9B1C1C' : '#0E3A21';
      toast.classList.remove('hide');
      setTimeout(() => {
        toast.classList.add('hide');
      }, 3500);
    }

    // Community card join/leave actions
    document.querySelectorAll('.community-card button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!isLoggedIn) {
          showToast('Harap login terlebih dahulu untuk bergabung.', true);
          setTimeout(() => {
            window.location.href = '/login?redirect=/komunitas';
          }, 800);
          return;
        }

        const action = btn.getAttribute('data-action');
        const communityId = btn.getAttribute('data-id');
        const communityName = btn.getAttribute('data-name');
        const card = btn.closest('.community-card');

        btn.disabled = true;

        try {
          if (action === 'join') {
            const res = await fetch('/api/communities/join', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                community_id: communityId,
                community_name: communityName,
              }),
            });
            const data = await res.json();

            if (!res.ok) {
              showToast(data.error || 'Gagal bergabung dengan komunitas.', true);
              btn.disabled = false;
              return;
            }

            showToast(`Berhasil bergabung dengan ${communityName}!`);
            btn.setAttribute('data-action', 'leave');
            btn.textContent = 'Batal Gabung';
            btn.className = 'btn btn-leave';
            if (card) {
              card.classList.add('is-joined');
              const topEl = card.querySelector('.card-top');
              if (topEl && !topEl.querySelector('.badge.visi')) {
                const badge = document.createElement('span');
                badge.className = 'badge visi';
                badge.style.marginLeft = 'auto';
                badge.style.background = 'var(--g500)';
                badge.textContent = '✓ Sudah Bergabung';
                topEl.appendChild(badge);
              }
            }
          } else {
            const res = await fetch('/api/communities/leave', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                community_id: communityId,
              }),
            });
            const data = await res.json();

            if (!res.ok) {
              showToast(data.error || 'Gagal keluar dari komunitas.', true);
              btn.disabled = false;
              return;
            }

            showToast(`Berhasil keluar dari ${communityName}.`);
            btn.setAttribute('data-action', 'join');
            btn.textContent = 'Gabung Komunitas';
            btn.className = 'btn btn-join primary';
            if (card) {
              card.classList.remove('is-joined');
              const badge = card.querySelector('.badge.visi');
              if (badge) badge.remove();
            }
          }
        } catch (err) {
          showToast('Terjadi kesalahan jaringan.', true);
        } finally {
          btn.disabled = false;
        }
      });
    });

    // Form pendaftaran komunitas baru
    const form = document.getElementById('daftarKomunitasForm');
    const feedback = document.getElementById('formFeedback');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (feedback) {
          feedback.classList.remove('hide');
          feedback.style.display = 'block';
        }
        form.reset();
      });
    }

    // Pagination & Search Logic
    const ITEMS_PER_PAGE = 8;
    let currentPage = 1;
    let visibleWrappers = [];

    const allWrappers = Array.from(document.querySelectorAll('.community-card-wrapper'));
    const searchInput = document.getElementById('searchCommunityInput');
    const paginationInfo = document.getElementById('paginationInfo');
    const pageNumberButtons = document.getElementById('pageNumberButtons');
    const prevBtn = document.getElementById('prevPageBtn');
    const nextBtn = document.getElementById('nextPageBtn');
    const noFoundBox = document.getElementById('noCommunityFound');

    function applyFilterAndPagination() {
      const query = (searchInput?.value || '').toLowerCase().trim();

      // Filter
      visibleWrappers = allWrappers.filter((wrapper) => {
        if (!query) return true;
        const name = wrapper.getAttribute('data-name') || '';
        const scope = wrapper.getAttribute('data-scope') || '';
        const desc = wrapper.getAttribute('data-desc') || '';
        return name.includes(query) || scope.includes(query) || desc.includes(query);
      });

      const totalItems = visibleWrappers.length;
      const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // Hide all first
      allWrappers.forEach((w) => (w.style.display = 'none'));

      if (totalItems === 0) {
        if (noFoundBox) noFoundBox.classList.remove('hide');
        if (paginationInfo) paginationInfo.textContent = 'Tidak ada komunitas yang cocok.';
      } else {
        if (noFoundBox) noFoundBox.classList.add('hide');
        const startIdx = (currentPage - 1) * ITEMS_PER_PAGE;
        const endIdx = Math.min(startIdx + ITEMS_PER_PAGE, totalItems);

        for (let i = startIdx; i < endIdx; i++) {
          visibleWrappers[i].style.display = 'block';
        }

        if (paginationInfo) {
          paginationInfo.textContent = `Menampilkan ${startIdx + 1}-${endIdx} dari ${totalItems} komunitas`;
        }
      }

      renderPaginationControls(totalPages);
    }

    function renderPaginationControls(totalPages) {
      if (!pageNumberButtons) return;
      pageNumberButtons.innerHTML = '';

      if (totalPages <= 1) {
        if (prevBtn) prevBtn.disabled = true;
        if (nextBtn) nextBtn.disabled = true;
        return;
      }

      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages;

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `page-num-btn ${i === currentPage ? 'active' : ''}`;
        btn.textContent = String(i);
        btn.addEventListener('click', () => {
          currentPage = i;
          applyFilterAndPagination();
          window.scrollTo({ top: 380, behavior: 'smooth' });
        });
        pageNumberButtons.appendChild(btn);
      }
    }

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        applyFilterAndPagination();
        window.scrollTo({ top: 380, behavior: 'smooth' });
      }
    });

    nextBtn?.addEventListener('click', () => {
      const totalPages = Math.ceil(visibleWrappers.length / ITEMS_PER_PAGE) || 1;
      if (currentPage < totalPages) {
        currentPage++;
        applyFilterAndPagination();
        window.scrollTo({ top: 380, behavior: 'smooth' });
      }
    });

    searchInput?.addEventListener('input', () => {
      currentPage = 1;
      applyFilterAndPagination();
    });

    // Check URL query param ?q=
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    if (initialQuery && searchInput) {
      searchInput.value = initialQuery;
    }

    // Initial run
    applyFilterAndPagination();
  </script>
</Layout>
