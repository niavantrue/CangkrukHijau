  <!-- ============ HOTLINE ============ -->
  <ReportBanner />

  <script>
    (function(){
      // --- filter taman ---
      const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
      const taman = document.querySelectorAll<HTMLLIElement>('#daftarTaman li');
      const kosongT = document.getElementById('kosongTaman');
      const cari = document.getElementById('cari') as HTMLInputElement | null;
      let aktif = 'semua';

      function saring() {
        const q = (cari?.value || '').trim().toLowerCase();
        let n = 0;
        taman.forEach((li) => {
          const okS = aktif === 'semua' || (li.dataset.s || '').indexOf(aktif) > -1;
          const okQ = q === '' || (li.textContent || '').toLowerCase().indexOf(q) > -1;
          const ok = okS && okQ;
          li.classList.toggle('hide', !ok);
          if (ok) n++;
        });
        if (kosongT) kosongT.classList.toggle('hide', n > 0);
      }

      chips.forEach((c) => {
        c.addEventListener('click', () => {
          chips.forEach((o) => o.setAttribute('aria-pressed', 'false'));
          c.setAttribute('aria-pressed', 'true');
          aktif = c.dataset.f || 'semua';
          saring();
        });
      });

      // --- filter berita ---
      const berita = document.querySelectorAll<HTMLElement>('#daftarBerita .ncard');
      const kosongB = document.getElementById('kosongBerita');
      function saringBerita() {
        const q = (cari?.value || '').trim().toLowerCase();
        let n = 0;
        berita.forEach((c) => {
          const ok = q === '' || (c.textContent || '').toLowerCase().indexOf(q) > -1;
          c.style.display = ok ? '' : 'none';
          if (ok) n++;
        });
        if (kosongB) kosongB.classList.toggle('hide', n > 0);
      }

      if (cari) {
        cari.addEventListener('input', () => {
          saring();
          saringBerita();
        });
      }

      // --- scroll spy menu ---
      const sections = document.querySelectorAll('section[id]');
      const links = document.querySelectorAll('.menu a');
      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              links.forEach((a) => {
                a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id);
              });
            }
          });
        }, { rootMargin: '-45% 0px -50% 0px' });
        sections.forEach((s) => obs.observe(s));
      }
    })();
  </script>
</Layout>
