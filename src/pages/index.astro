    <div class="wrap">
      <div class="panel">
        <div class="shead">
          <div class="stitle">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l12-2v13" stroke="#3E9B5F" stroke-width="2.2" fill="none"/><circle cx="6" cy="18" r="3" fill="#3E9B5F"/><circle cx="18" cy="16" r="3" fill="#8FCBA3"/></svg>
