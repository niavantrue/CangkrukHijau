  <!-- ============================================================== -->
  <!-- CLIENT INTERACTIVE SCRIPT -->
  <!-- ============================================================== -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Elements
      const searchInput = document.getElementById('reportSearchInput') as HTMLInputElement | null;
      const clearSearchBtn = document.getElementById('clearSearchBtn');
      const filterStatusSelect = document.getElementById('filterStatusSelect') as HTMLSelectElement | null;
      const filterCategorySelect = document.getElementById('filterCategorySelect') as HTMLSelectElement | null;
      const filterUrgencySelect = document.getElementById('filterUrgencySelect') as HTMLSelectElement | null;
      const btnViewTable = document.getElementById('btnViewTable');
      const btnViewCards = document.getElementById('btnViewCards');
      const tableViewContainer = document.getElementById('tableViewContainer');
      const cardsViewContainer = document.getElementById('cardsViewContainer');
      const noResultsState = document.getElementById('noResultsState');
      const btnResetFilters = document.getElementById('btnResetFilters');
      const btnEmptyReset = document.getElementById('btnEmptyReset');
      const visibleCount = document.getElementById('visibleCount');
      const activeFilterTags = document.getElementById('activeFilterTags');

      // Metric cards clickable filter
      const metricCards = document.querySelectorAll('.metric-card[data-filter-status]');

      // Modal elements
      const modal = document.getElementById('reportDetailModal');
      const modalCloseBtn = document.getElementById('modalCloseBtn');
      const mId = document.getElementById('mId');
      const mDate = document.getElementById('mDate');
      const modalReportTitle = document.getElementById('modalReportTitle');
      const mStatusBadge = document.getElementById('mStatusBadge');
      const mStatusText = document.getElementById('mStatusText');
      const mUrgencyBadge = document.getElementById('mUrgencyBadge');
      const mCategoryBadge = document.getElementById('mCategoryBadge');
      const mDeskripsi = document.getElementById('mDeskripsi');
      const mPhotoContainer = document.getElementById('mPhotoContainer');
      const mPhotoImg = document.getElementById('mPhotoImg') as HTMLImageElement | null;
      const mPhotoLink = document.getElementById('mPhotoLink') as HTMLAnchorElement | null;
      const mNoPhotoNotice = document.getElementById('mNoPhotoNotice');
      const mNama = document.getElementById('mNama');
      const mEmail = document.getElementById('mEmail');
      const mKontak = document.getElementById('mKontak');
      const mWaBtn = document.getElementById('mWaBtn') as HTMLAnchorElement | null;
      const mLokasi = document.getElementById('mLokasi');
      const mKecamatan = document.getElementById('mKecamatan');
      const mKoordinat = document.getElementById('mKoordinat');
      const mCoordWrap = document.getElementById('mCoordWrap');
      const mMapsBtn = document.getElementById('mMapsBtn') as HTMLAnchorElement | null;
      const modalFormReportId = document.getElementById('modalFormReportId') as HTMLInputElement | null;
      const mStatusSelect = document.getElementById('mStatusSelect') as HTMLSelectElement | null;
      const mAdminNotes = document.getElementById('mAdminNotes') as HTMLTextAreaElement | null;
      const modalStatusForm = document.getElementById('modalStatusForm') as HTMLFormElement | null;
      const modalActionFeedback = document.getElementById('modalActionFeedback');
      const modalSaveStatusBtn = document.getElementById('modalSaveStatusBtn') as HTMLButtonElement | null;
      const toastContainer = document.getElementById('toastContainer');

      // Helper: Toast notification
      function showToast(message: string, isError = false) {
        if (!toastContainer) return;
        const toast = document.createElement('div');
        toast.className = `toast-msg ${isError ? 'error' : 'success'}`;
        toast.textContent = message;
        toastContainer.appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transition = 'opacity 0.3s ease';
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }

      // 2. Filter & Search Logic
      function applyFilters() {
        const query = (searchInput?.value || '').trim().toLowerCase();
        const statusFilter = filterStatusSelect?.value || '';
        const categoryFilter = filterCategorySelect?.value || '';
        const urgencyFilter = filterUrgencySelect?.value || '';

        // Toggle clear search button
        if (clearSearchBtn) {
          if (query) {
            clearSearchBtn.classList.remove('hide');
          } else {
            clearSearchBtn.classList.add('hide');
          }
        }

        // Toggle reset filters button
        const hasActiveFilter = Boolean(query || statusFilter || categoryFilter || urgencyFilter);
        if (btnResetFilters) {
          if (hasActiveFilter) {
            btnResetFilters.classList.remove('hide');
          } else {
            btnResetFilters.classList.add('hide');
          }
        }

        // Render active filter tags
        if (activeFilterTags) {
          activeFilterTags.innerHTML = '';
          if (statusFilter) {
            const pill = document.createElement('span');
            pill.className = 'filter-tag-pill';
            pill.textContent = `Status: ${statusFilter}`;
            activeFilterTags.appendChild(pill);
          }
          if (categoryFilter) {
            const pill = document.createElement('span');
            pill.className = 'filter-tag-pill';
            pill.textContent = `Kategori: ${categoryFilter}`;
            activeFilterTags.appendChild(pill);
          }
          if (urgencyFilter) {
            const pill = document.createElement('span');
            pill.className = 'filter-tag-pill';
            pill.textContent = `Urgensi: ${urgencyFilter}`;
            activeFilterTags.appendChild(pill);
          }
        }

        const rows = document.querySelectorAll<HTMLTableRowElement>('.report-row');
        const cards = document.querySelectorAll<HTMLDivElement>('.report-card');
        let matched = 0;

        rows.forEach((row) => {
          const id = row.getAttribute('data-id') || '';
          const nama = row.getAttribute('data-nama') || '';
          const lokasi = row.getAttribute('data-lokasi') || '';
          const kecamatan = row.getAttribute('data-kecamatan') || '';
          const kategori = row.getAttribute('data-kategori') || '';
          const urgensi = row.getAttribute('data-urgensi') || '';
          const status = row.getAttribute('data-status') || '';
          const judul = row.getAttribute('data-judul') || '';
          const deskripsi = row.getAttribute('data-deskripsi') || '';

          const matchQuery =
            !query ||
            id.toLowerCase().includes(query) ||
            nama.includes(query) ||
            lokasi.includes(query) ||
            kecamatan.includes(query) ||
            judul.includes(query) ||
            deskripsi.includes(query);

          const matchStatus = !statusFilter || status === statusFilter;
          const matchCategory = !categoryFilter || kategori === categoryFilter;
          const matchUrgency = !urgencyFilter || urgensi === urgencyFilter;

          const isVisible = matchQuery && matchStatus && matchCategory && matchUrgency;

          if (isVisible) {
            row.style.display = '';
            matched++;
          } else {
            row.style.display = 'none';
          }
        });

        cards.forEach((card) => {
          const id = card.getAttribute('data-id') || '';
          const nama = card.getAttribute('data-nama') || '';
          const lokasi = card.getAttribute('data-lokasi') || '';
          const kecamatan = card.getAttribute('data-kecamatan') || '';
          const kategori = card.getAttribute('data-kategori') || '';
          const urgensi = card.getAttribute('data-urgensi') || '';
          const status = card.getAttribute('data-status') || '';
          const judul = card.getAttribute('data-judul') || '';
          const deskripsi = card.getAttribute('data-deskripsi') || '';

          const matchQuery =
            !query ||
            id.toLowerCase().includes(query) ||
            nama.includes(query) ||
            lokasi.includes(query) ||
            kecamatan.includes(query) ||
            judul.includes(query) ||
            deskripsi.includes(query);

          const matchStatus = !statusFilter || status === statusFilter;
          const matchCategory = !categoryFilter || kategori === categoryFilter;
          const matchUrgency = !urgencyFilter || urgensi === urgencyFilter;

          if (matchQuery && matchStatus && matchCategory && matchUrgency) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount) {
          visibleCount.textContent = String(matched);
        }

        if (noResultsState) {
          if (matched === 0) {
            noResultsState.classList.remove('hide');
          } else {
            noResultsState.classList.add('hide');
          }
        }
      }

      // Attach filter listeners
      searchInput?.addEventListener('input', applyFilters);
      clearSearchBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        applyFilters();
        searchInput?.focus();
      });

      filterStatusSelect?.addEventListener('change', applyFilters);
      filterCategorySelect?.addEventListener('change', applyFilters);
      filterUrgencySelect?.addEventListener('change', applyFilters);

      const resetAll = () => {
        if (searchInput) searchInput.value = '';
        if (filterStatusSelect) filterStatusSelect.value = '';
        if (filterCategorySelect) filterCategorySelect.value = '';
        if (filterUrgencySelect) filterUrgencySelect.value = '';
        applyFilters();
      };

      btnResetFilters?.addEventListener('click', resetAll);
      btnEmptyReset?.addEventListener('click', resetAll);

      // Metric cards quick status filter
      metricCards.forEach((card) => {
        card.addEventListener('click', () => {
          const filterValue = card.getAttribute('data-filter-status') || '';
          if (filterStatusSelect) {
            filterStatusSelect.value = filterValue;
            applyFilters();
          }
        });
      });

      // 3. View Switcher (Table vs Grid Cards)
      btnViewTable?.addEventListener('click', () => {
        btnViewTable.classList.add('active');
        btnViewCards?.classList.remove('active');
        tableViewContainer?.classList.remove('hide');
        cardsViewContainer?.classList.add('hide');
      });

      btnViewCards?.addEventListener('click', () => {
        btnViewCards.classList.add('active');
        btnViewTable?.classList.remove('active');
        tableViewContainer?.classList.add('hide');
        cardsViewContainer?.classList.remove('hide');
      });

      // 4. Perubahan Status Operasional (Dropdown di Tabel / Kartu)
      async function handleStatusChange(reportId: string, newStatus: string, selectElem: HTMLSelectElement) {
        const spin = document.getElementById(`spin-${reportId}`);
        if (spin) spin.classList.remove('hide');
        selectElem.disabled = true;

        try {
          const res = await fetch('/api/admin/reports/update-status', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: reportId,
              status: newStatus,
            }),
          });

          const json = await res.json();

          if (!res.ok || json.error) {
            throw new Error(json.error || 'Gagal menyimpan status ke server.');
          }

          // Update UI badge & attributes
          updateReportStatusInDom(reportId, newStatus);
          showToast(`✓ Status laporan ${reportId} berhasil diubah ke [${newStatus}]!`);
        } catch (err: any) {
          showToast(err.message || 'Terjadi kesalahan.', true);
          // Revert select value to previous
          const row = document.getElementById(`row-${reportId}`);
          if (row) {
            const currentStatus = row.getAttribute('data-status') || 'Menunggu';
            selectElem.value = currentStatus;
          }
        } finally {
          if (spin) spin.classList.add('hide');
          selectElem.disabled = false;
        }
      }

      function updateReportStatusInDom(reportId: string, newStatus: string, newNotes = '') {
        const statusClass = `status-${newStatus.toLowerCase()}`;

        // Update Row
        const row = document.getElementById(`row-${reportId}`);
        if (row) {
          row.setAttribute('data-status', newStatus);
          const badge = document.getElementById(`status-badge-${reportId}`);
          if (badge) {
            badge.className = `status-badge-main ${statusClass}`;
            const text = badge.querySelector('.status-text');
            if (text) text.textContent = newStatus;
          }
          const rowSelect = row.querySelector<HTMLSelectElement>('.status-changer-select');
          if (rowSelect) rowSelect.value = newStatus;
        }

        // Update Card
        const card = document.getElementById(`card-${reportId}`);
        if (card) {
          card.setAttribute('data-status', newStatus);
          const cardBadge = document.getElementById(`card-status-badge-${reportId}`);
          if (cardBadge) {
            cardBadge.className = `status-badge-main ${statusClass}`;
            const cardText = cardBadge.querySelector('.status-text');
            if (cardText) cardText.textContent = newStatus;
          }
          const cardSelect = card.querySelector<HTMLSelectElement>('.status-changer-select');
          if (cardSelect) cardSelect.value = newStatus;
        }

        // Update Modal if open
        if (modalFormReportId?.value === reportId) {
          if (mStatusBadge) {
            mStatusBadge.className = `status-badge-main ${statusClass}`;
          }
          if (mStatusText) mStatusText.textContent = newStatus;
          if (mStatusSelect) mStatusSelect.value = newStatus;
        }

        // Recalculate Metric Counters
        recalculateCounters();
      }

      function recalculateCounters() {
        const allRows = document.querySelectorAll<HTMLTableRowElement>('.report-row');
        let total = 0, menunggu = 0, diproses = 0, selesai = 0, ditolak = 0;

        allRows.forEach((row) => {
          total++;
          const status = row.getAttribute('data-status');
          if (status === 'Menunggu') menunggu++;
          else if (status === 'Diproses') diproses++;
          else if (status === 'Selesai') selesai++;
          else if (status === 'Ditolak') ditolak++;
        });

        const cTotal = document.getElementById('countTotal');
        const cMenunggu = document.getElementById('countMenunggu');
        const cDiproses = document.getElementById('countDiproses');
        const cSelesai = document.getElementById('countSelesai');
        const cDitolak = document.getElementById('countDitolak');

        if (cTotal) cTotal.textContent = String(total);
        if (cMenunggu) cMenunggu.textContent = String(menunggu);
        if (cDiproses) cDiproses.textContent = String(diproses);
        if (cSelesai) cSelesai.textContent = String(selesai);
        if (cDitolak) cDitolak.textContent = String(ditolak);
      }

      // Listen on status dropdown changes across rows and cards
      document.addEventListener('change', (e) => {
        const target = e.target as HTMLElement;
        if (target && target.classList.contains('status-changer-select')) {
          const select = target as HTMLSelectElement;
          const reportId = select.getAttribute('data-report-id');
          if (reportId) {
            handleStatusChange(reportId, select.value, select);
          }
        }
      });

      // 5. Modal Detail Laporan
      function openReportModal(report: any) {
        if (!modal) return;

        if (mId) mId.textContent = report.id;

        const dateObj = new Date(report.created_at);
        const formattedDate = !isNaN(dateObj.getTime())
          ? dateObj.toLocaleDateString('id-ID', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            }) + ' • ' + dateObj.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB'
          : report.created_at;

        if (mDate) mDate.textContent = formattedDate;
        if (modalReportTitle) modalReportTitle.textContent = report.judul;

        // Badges
        const statusClass = `status-${String(report.status || 'menunggu').toLowerCase()}`;
        if (mStatusBadge) mStatusBadge.className = `status-badge-main ${statusClass}`;
        if (mStatusText) mStatusText.textContent = report.status;

        if (mUrgencyBadge) {
          const u = report.urgensi || 'Sedang';
          mUrgencyBadge.className = `urgency-badge ${u === 'Kritis' ? 'critical' : u === 'Tinggi' ? 'high' : u === 'Sedang' ? 'medium' : 'normal'}`;
          mUrgencyBadge.textContent = u;
        }

        if (mCategoryBadge) mCategoryBadge.textContent = report.kategori;
        if (mDeskripsi) mDeskripsi.textContent = report.deskripsi || '-';

        // Photo
        if (report.foto_url) {
          if (mPhotoContainer) mPhotoContainer.classList.remove('hide');
          if (mNoPhotoNotice) mNoPhotoNotice.classList.add('hide');
          if (mPhotoImg) mPhotoImg.src = report.foto_url;
          if (mPhotoLink) mPhotoLink.href = report.foto_url;
        } else {
          if (mPhotoContainer) mPhotoContainer.classList.add('hide');
          if (mNoPhotoNotice) mNoPhotoNotice.classList.remove('hide');
        }

        // Reporter
        if (mNama) mNama.textContent = report.nama_pelapor || 'Warga Surabaya';
        if (mEmail) mEmail.textContent = report.email || '-';
        if (mKontak) mKontak.textContent = report.whatsapp || report.kontak || '-';

        const cleanPhone = String(report.whatsapp || report.kontak || '').replace(/[^0-9]/g, '');
        if (mWaBtn) {
          if (cleanPhone) {
            const intlPhone = cleanPhone.startsWith('0') ? '62' + cleanPhone.slice(1) : cleanPhone;
            mWaBtn.href = `https://wa.me/${intlPhone}?text=Halo%20${encodeURIComponent(report.nama_pelapor)}%2C%20kami%20dari%20Pengelola%20Cangkruk%20Hijau%20Surabaya%20terkait%20laporan%20pengaduan%20lingkungan%20(${encodeURIComponent(report.id)}).`;
            mWaBtn.style.display = 'flex';
          } else {
            mWaBtn.style.display = 'none';
          }
        }

        // Location & Maps
        if (mLokasi) mLokasi.textContent = report.lokasi || '-';
        if (mKecamatan) mKecamatan.textContent = report.kecamatan || 'Kota Surabaya';

        if (report.koordinat) {
          if (mCoordWrap) mCoordWrap.style.display = '';
          if (mKoordinat) mKoordinat.textContent = report.koordinat;
          if (mMapsBtn) {
            mMapsBtn.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(report.koordinat)}`;
            mMapsBtn.style.display = 'flex';
          }
        } else {
          if (mCoordWrap) mCoordWrap.style.display = 'none';
          if (mMapsBtn) {
            mMapsBtn.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(report.lokasi + ', Surabaya')}`;
            mMapsBtn.style.display = 'flex';
          }
        }

        // Form Status in Modal
        if (modalFormReportId) modalFormReportId.value = report.id;
        if (mStatusSelect) mStatusSelect.value = report.status || 'Menunggu';
        if (mAdminNotes) mAdminNotes.value = report.catatan_admin || '';
        if (modalActionFeedback) modalActionFeedback.classList.add('hide');

        modal.classList.remove('hide');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.add('hide');
        document.body.style.overflow = '';
      }

      modalCloseBtn?.addEventListener('click', closeModal);

      // Dismiss on backdrop click
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      // Dismiss on Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal?.classList.contains('hide')) {
          closeModal();
        }
      });

      // Listen on all "Detail" trigger buttons
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.btn-detail-trigger');
        if (btn) {
          const jsonStr = btn.getAttribute('data-report-json');
          if (jsonStr) {
            try {
              const data = JSON.parse(jsonStr);
              // Check if report status has been updated in memory
              const row = document.getElementById(`row-${data.id}`);
              if (row) {
                const currentStatus = row.getAttribute('data-status');
                if (currentStatus) data.status = currentStatus;
              }
              openReportModal(data);
            } catch (err) {
              console.error('Failed to parse report json', err);
            }
          }
        }
      });

      // Handle Modal Status Form Submission
      modalStatusForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = modalFormReportId?.value;
        const status = mStatusSelect?.value;
        const notes = mAdminNotes?.value.trim();

        if (!id || !status) return;

        if (modalSaveStatusBtn) {
          modalSaveStatusBtn.disabled = true;
          const txt = modalSaveStatusBtn.querySelector('.btn-text');
          const spin = modalSaveStatusBtn.querySelector('.btn-spin');
          txt?.classList.add('hide');
          spin?.classList.remove('hide');
        }

        if (modalActionFeedback) modalActionFeedback.classList.add('hide');

        try {
          const res = await fetch('/api/admin/reports/update-status', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id,
              status,
              catatan_admin: notes,
            }),
          });

          const json = await res.json();

          if (!res.ok || json.error) {
            throw new Error(json.error || 'Gagal menyimpan status ke server.');
          }

          updateReportStatusInDom(id, status, notes);

          if (modalActionFeedback) {
            modalActionFeedback.className = 'action-feedback success';
            modalActionFeedback.textContent = `✓ Status berhasil diperbarui menjadi "${status}".`;
            modalActionFeedback.classList.remove('hide');
          }

          showToast(`✓ Status laporan ${id} berhasil disimpan ke database!`);

          setTimeout(() => {
            closeModal();
          }, 1000);
        } catch (err: any) {
          if (modalActionFeedback) {
            modalActionFeedback.className = 'action-feedback error';
            modalActionFeedback.textContent = err.message || 'Gagal menyimpan perubahan status.';
            modalActionFeedback.classList.remove('hide');
          }
          showToast(err.message || 'Gagal menyimpan status.', true);
        } finally {
          if (modalSaveStatusBtn) {
            modalSaveStatusBtn.disabled = false;
            const txt = modalSaveStatusBtn.querySelector('.btn-text');
            const spin = modalSaveStatusBtn.querySelector('.btn-spin');
            txt?.classList.remove('hide');
            spin?.classList.add('hide');
          }
        }
      });
    });
  </script>
</Layout>
