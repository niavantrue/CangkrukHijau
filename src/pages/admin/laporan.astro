          <!-- Col Right: Identitas Pelapor, Lokasi, Peta, Form Status -->
          <div class="modal-side-col">
            <!-- Kartu Pelapor -->
            <div class="modal-side-card">
              <h4 class="side-card-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
                <span>Identitas Pelapor</span>
              </h4>
              <div class="side-info-item">
                <span class="info-label">Nama Lengkap</span>
                <strong class="info-val" id="mNama">Bambang Sudibyo</strong>
              </div>
              <div class="side-info-item">
                <span class="info-label">Email</span>
                <span class="info-val" id="mEmail">bambang@gmail.com</span>
              </div>
              <div class="side-info-item">
                <span class="info-label">No. WhatsApp / Kontak</span>
                <strong class="info-val" id="mKontak">08123456789</strong>
              </div>
              <div style="margin-top: 10px;">
                <a id="mWaBtn" href="#" target="_blank" rel="noopener noreferrer" class="btn-modal-wa">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
                  </svg>
                  <span>Chat WhatsApp Pelapor</span>
                </a>
              </div>
            </div>

            <!-- Kartu Titik Lokasi & Koordinat -->
            <div class="modal-side-card">
              <h4 class="side-card-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                </svg>
                <span>Titik Lokasi Kejadian</span>
              </h4>
              <div class="side-info-item">
                <span class="info-label">Alamat / Titik Lapangan</span>
                <span class="info-val" id="mLokasi">Alamat detail</span>
              </div>
              <div class="side-info-item">
                <span class="info-label">Kecamatan</span>
                <span class="info-val" id="mKecamatan">Wonokromo</span>
              </div>
              <div class="side-info-item" id="mCoordWrap">
                <span class="info-label">Koordinat GPS</span>
                <span class="info-val font-mono" id="mKoordinat">-7.29944, 112.74833</span>
              </div>
              <div style="margin-top: 10px;">
                <a id="mMapsBtn" href="#" target="_blank" rel="noopener noreferrer" class="btn-modal-maps">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
                    <line x1="8" y1="2" x2="8" y2="18"/>
                    <line x1="16" y1="6" x2="16" y2="22"/>
                  </svg>
                  <span>Lihat di Google Maps</span>
                </a>
              </div>
            </div>

            <!-- Form Perubahan Status Operasional -->
            <div class="modal-side-card highlight-card">
              <h4 class="side-card-title" style="color: var(--g900);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span>Tindak Lanjut & Status Operasional</span>
              </h4>

              <form id="modalStatusForm" class="modal-status-form">
                <input type="hidden" id="modalFormReportId" value="" />

                <div class="field-item">
                  <label for="mStatusSelect" class="field-label">Ubah Status Tindak Lanjut</label>
                  <select id="mStatusSelect" class="form-select-status" required>
                    <option value="Menunggu">🟡 Menunggu (Verifikasi Awal)</option>
                    <option value="Diproses">🔵 Diproses (Satgas di Lapangan)</option>
                    <option value="Selesai">🟢 Selesai (Tuntas / Terverifikasi)</option>
                    <option value="Ditolak">🔴 Ditolak (Tidak Memenuhi Syarat)</option>
                  </select>
                </div>

                <div class="field-item" style="margin-top: 12px;">
                  <label for="mAdminNotes" class="field-label">Catatan Admin / Satgas Terkait</label>
                  <textarea
                    id="mAdminNotes"
                    rows="3"
                    class="form-textarea-notes"
                    placeholder="Contoh: Satgas DKRTH Rayon Pusat diterjunkan ke lokasi untuk pengangkutan sampah..."
                  ></textarea>
                </div>

                <div id="modalActionFeedback" class="action-feedback hide"></div>

                <button id="modalSaveStatusBtn" type="submit" class="btn-save-status">
                  <span class="btn-text">Simpan Status ke Database</span>
                  <span class="btn-spin hide">Menyimpan ke Supabase...</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="toast-container" aria-live="polite"></div>

  <style>
    /* ==========================================================================
       Dashboard & Report Management Styling
       ========================================================================== */
    .admin-reports-page {
      padding: 32px 0 80px;
      background: #F4F7F2;
      min-height: 88vh;
    }

    /* Top Bar */
    .admin-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
      padding: 24px 30px;
      background: #FFFFFF;
      border: 1px solid var(--line);
      border-radius: var(--r);
      box-shadow: var(--shadow);
    }
    .admin-user-info {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .admin-avatar {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      background: #0E3A21;
      color: #8FCBA3;
      display: grid;
      place-items: center;
      flex: none;
    }
    .admin-badge-sm {
      font-size: 11px;
      font-weight: 800;
      color: var(--g700);
      letter-spacing: 0.08em;
    }
    .admin-title {
      font-size: 24px;
      color: var(--g900);
      margin-top: 2px;
    }
    .admin-sub {
      font-size: 13.5px;
      color: var(--muted);
      margin-top: 3px;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .db-source-tag {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 100px;
      background: #FEF3C7;
      color: #92400E;
      font-weight: 700;
    }
    .db-source-tag.live {
      background: #DEF7EC;
      color: #03543F;
    }

    /* Actions Top */
    .admin-header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn-subnav, .btn-portal-client, .btn-admin-logout {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13.5px;
      font-weight: 700;
      padding: 9px 15px;
      border-radius: 10px;
      transition: background 0.15s, transform 0.15s;
      cursor: pointer;
    }
    .btn-subnav {
      background: var(--g50);
      border: 1px solid var(--line);
      color: var(--g700);
    }
    .btn-subnav:hover {
      background: var(--g100);
    }
    .btn-portal-client {
      background: #FFFFFF;
      border: 1px solid var(--line);
      color: var(--text);
    }
    .btn-portal-client:hover {
      background: var(--g50);
    }
    .btn-admin-logout {
      background: #FDE8E8;
      border: 1px solid #F8B4B4;
      color: #9B1C1C;
    }
    .btn-admin-logout:hover {
      background: #F8B4B4;
    }

    /* Tabs Nav */
    .admin-tabs-nav {
      display: flex;
      gap: 12px;
      margin-top: 20px;
      flex-wrap: wrap;
    }
    .tab-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 700;
      background: #FFFFFF;
      border: 1px solid var(--line);
      color: var(--muted);
      transition: all 0.15s;
    }
    .tab-pill:hover {
      background: var(--g50);
      color: var(--g900);
    }
    .tab-pill.active {
      background: var(--g900);
      border-color: var(--g900);
      color: #FFFFFF;
      box-shadow: 0 4px 12px rgba(14, 58, 33, 0.2);
    }

    /* Metrics Grid */
    .admin-metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
      margin-top: 24px;
    }
    .metric-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px;
      background: #FFFFFF;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      box-shadow: var(--shadow);
      cursor: pointer;
      transition: transform 0.15s, border-color 0.15s;
    }
    .metric-card:hover {
      transform: translateY(-2px);
      border-color: var(--g500);
    }
    .metric-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      flex: none;
    }
    .gray-bg { background: #F3F4F6; color: #4B5563; }
    .yellow-bg { background: #FEF9C3; color: #854D0E; }
    .blue-bg { background: #DBEAFE; color: #1E40AF; }
    .green-bg { background: #DEF7EC; color: #03543F; }
    .red-bg { background: #FDE8E8; color: #9B1C1C; }

    .yellow-text { color: #854D0E; }
    .blue-text { color: #1E40AF; }
    .green-text { color: #03543F; }
    .red-text { color: #9B1C1C; }

    .metric-details {
      display: flex;
      flex-direction: column;
    }
    .metric-label {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--muted);
    }
    .metric-value {
      font-family: var(--logo);
      font-size: 28px;
      font-weight: 800;
      color: var(--g900);
      line-height: 1.1;
      margin: 2px 0;
    }
    .metric-hint {
      font-size: 11px;
      color: var(--muted);
    }

    /* Main Section Panel */
    .admin-main-section {
      margin-top: 28px;
      background: #FFFFFF;
      border: 1px solid var(--line);
      border-radius: var(--r);
      padding: 24px 28px;
      box-shadow: var(--shadow);
    }

    /* Controls Toolbar */
    .controls-toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--line);
    }
    .search-box-wrapper {
      position: relative;
      flex: 1 1 280px;
      min-width: 240px;
    }
    .search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      pointer-events: none;
    }
    .search-box-wrapper input {
      width: 100%;
      padding: 10px 38px 10px 40px;
      border: 1px solid var(--line);
      border-radius: 10px;
      font-size: 13.5px;
      color: var(--text);
      background: #FAFAFA;
      transition: all 0.15s;
    }
    .search-box-wrapper input:focus {
      background: #FFFFFF;
      border-color: var(--g600);
      outline: none;
      box-shadow: 0 0 0 3px rgba(27, 107, 58, 0.12);
    }
    .clear-search-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: #E5E7EB;
      border: none;
      color: #4B5563;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      font-size: 11px;
      display: grid;
      place-items: center;
      cursor: pointer;
    }

    .filter-select {
      padding: 10px 14px;
      border: 1px solid var(--line);
      border-radius: 10px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--text);
      background: #FFFFFF;
      cursor: pointer;
      transition: border-color 0.15s;
    }
    .filter-select:focus {
      border-color: var(--g600);
      outline: none;
    }

    .view-toggle-group {
      display: flex;
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      margin-left: auto;
    }
    .view-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      background: #FFFFFF;
      color: var(--muted);
      border: none;
      cursor: pointer;
      transition: all 0.15s;
    }
    .view-btn.active {
      background: var(--g900);
      color: #FFFFFF;
    }
    .btn-reset-filters {
      padding: 8px 14px;
      border-radius: 8px;
      background: #F3F4F6;
      border: 1px solid #D1D5DB;
      font-size: 12.5px;
      font-weight: 700;
      color: #4B5563;
      cursor: pointer;
    }
    .btn-reset-filters:hover {
      background: #E5E7EB;
    }

    /* Results Status Bar */
    .results-status-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 18px 0 14px;
      font-size: 13px;
      color: var(--muted);
      flex-wrap: wrap;
    }
    .results-count strong {
      color: var(--g900);
    }
    .active-filter-tags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .filter-tag-pill {
      font-size: 11.5px;
      padding: 3px 10px;
      border-radius: 100px;
      background: var(--g50);
      border: 1px solid var(--line);
      color: var(--g700);
      font-weight: 700;
    }

    /* Table View */
    .table-responsive {
      overflow-x: auto;
      border-radius: 12px;
      border: 1px solid var(--line);
      margin-top: 8px;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }
    .data-table th {
      background: #F8FAF7;
      color: var(--g900);
      font-weight: 700;
      padding: 13px 14px;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    .data-table td {
      padding: 13px 14px;
      border-bottom: 1px solid var(--line);
      color: var(--text);
      vertical-align: middle;
    }
    .data-table tbody tr:hover {
      background: #F8FCF8;
    }
    .data-table tbody tr:last-child td {
      border-bottom: none;
    }

    /* Monospace Report ID */
    .report-id-badge {
      font-family: monospace;
      font-size: 12px;
      font-weight: 800;
      background: #F3F4F6;
      color: #1F2937;
      padding: 4px 8px;
      border-radius: 6px;
      border: 1px solid #E5E7EB;
      white-space: nowrap;
    }
    .cell-date {
      white-space: nowrap;
      color: var(--muted);
      font-size: 12px;
    }

    /* Pelapor & Kontak */
    .reporter-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      max-width: 170px;
    }
    .reporter-name {
      color: var(--g900);
      font-size: 13.5px;
    }
    .reporter-email {
      font-size: 11.5px;
      color: var(--muted);
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .wa-quick-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: #057A55;
      font-size: 11.5px;
      font-weight: 700;
      text-decoration: underline;
    }
    .wa-quick-link:hover {
      color: #03543F;
    }
    .contact-pill {
      font-size: 11.5px;
      color: var(--muted);
    }

    /* Kategori Pill */
    .category-pill {
      display: inline-block;
      padding: 4px 9px;
      border-radius: 6px;
      background: #EDF4EE;
      color: #1A5430;
      font-size: 11.5px;
      font-weight: 700;
      white-space: nowrap;
    }

    /* Judul & Lokasi */
    .cell-title-loc {
      max-width: 250px;
    }
    .report-title-text {
      font-weight: 700;
      color: var(--g900);
      margin-bottom: 4px;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .report-loc-snippet {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      color: var(--muted);
    }
    .pin-icon {
      color: #E02424;
      flex: none;
    }

    /* Urgency Badges */
    .urgency-badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 11.5px;
      font-weight: 700;
      white-space: nowrap;
    }
    .urgency-badge.critical {
      background: #FDE8E8;
      color: #9B1C1C;
      border: 1px solid #F8B4B4;
    }
    .urgency-badge.high {
      background: #FEECDC;
      color: #B43403;
      border: 1px solid #FDBA8C;
    }
    .urgency-badge.medium {
      background: #FEF9C3;
      color: #854D0E;
