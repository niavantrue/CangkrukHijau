---
import Layout from '../../layouts/Layout.astro';
import { fetchReportsWithAdmin, isUserAdmin } from '../../lib/reportsService.js';

const user = Astro.locals.user;

// 1. Keamanan & Proteksi Akses: Jika belum login atau bukan admin, redirect ke /admin/login
if (!user || !isUserAdmin(user)) {
  return Astro.redirect('/admin/login?error=unauthorized');
}

// 2. Ambil data seluruh laporan menggunakan Supabase Admin Client
const { reports, source } = await fetchReportsWithAdmin();

const adminEmail = user.email || 'admin@cangkruk.id';

// Hitung metrik awal status
const counts = {
  total: reports.length,
  menunggu: reports.filter((r) => r.status === 'Menunggu').length,
  diproses: reports.filter((r) => r.status === 'Diproses').length,
  selesai: reports.filter((r) => r.status === 'Selesai').length,
  ditolak: reports.filter((r) => r.status === 'Ditolak').length,
};

// Ambil daftar unik kategori dan kecamatan untuk filter dropdown
const categories = Array.from(new Set(reports.map((r) => r.kategori).filter(Boolean)));
---

<Layout
  title="Kelola Laporan & Pengaduan Warga | Admin Cangkruk Hijau"
  description="Panel Pengawasan & Tindak Lanjut Laporan Kerusakan Lingkungan Hidup Kota Surabaya."
  activeNav="admin-laporan"
  lang="id"
>
  <main class="admin-reports-page">
    <div class="wrap">
      <!-- Top Navigation / Admin Header -->
      <div class="admin-top-bar panel">
        <div class="admin-user-info">
          <div class="admin-avatar">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
            </svg>
          </div>
          <div>
            <div class="admin-badge-sm">PORTAL ADMINISTRATOR • VERIFIKASI DLH</div>
            <h1 class="admin-title">Manajemen Laporan & Pengaduan Warga</h1>
            <p class="admin-sub">
              Login sebagai: <strong>{adminEmail}</strong> 
              {source === 'initial_seed' || source === 'fallback_initial' ? (
                <span class="db-source-tag" title="Data disajikan dari seed/simulasi karena tabel belum tersedia atau kredensial offline">Mode Simulasi Aktif</span>
              ) : (
                <span class="db-source-tag live" title={`Terhubung ke tabel Supabase: ${source}`}>Supabase Live ({source})</span>
              )}
            </p>
          </div>
        </div>

        <div class="admin-header-actions">
          <a href="/admin/dashboard" class="btn-subnav" title="Kembali ke Dashboard Ringkasan">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="9"/>
              <rect x="14" y="3" width="7" height="5"/>
              <rect x="14" y="12" width="7" height="9"/>
              <rect x="3" y="16" width="7" height="5"/>
            </svg>
            <span>Ringkasan Dashboard</span>
          </a>
          <a href="/" class="btn-portal-client" target="_blank" rel="noopener noreferrer">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            <span>Portal Publik</span>
          </a>
          <form action="/api/auth/logout" method="POST" style="display:inline; margin:0;">
            <button type="submit" class="btn-admin-logout" title="Keluar dari Portal Admin">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              <span>Keluar</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Quick Nav Tabs -->
      <div class="admin-tabs-nav">
        <a href="/admin/dashboard" class="tab-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
          <span>Ringkasan & FGD</span>
        </a>
        <a href="/admin/laporan" class="tab-pill active">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          <span>Kelola Laporan Warga ({reports.length})</span>
        </a>
      </div>

      <!-- Metric Stats Cards -->
      <section class="admin-metrics-grid">
        <!-- Card 1: Total Laporan -->
        <div class="metric-card panel" data-filter-status="">
          <div class="metric-icon gray-bg">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">Total Semua Laporan</span>
            <div class="metric-value" id="countTotal">{counts.total}</div>
            <span class="metric-hint">Seluruh pengaduan masuk</span>
          </div>
        </div>

        <!-- Card 2: Menunggu (Kuning) -->
        <div class="metric-card panel status-card-yellow" data-filter-status="Menunggu">
          <div class="metric-icon yellow-bg">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">Menunggu Verifikasi</span>
            <div class="metric-value yellow-text" id="countMenunggu">{counts.menunggu}</div>
            <span class="metric-hint">Perlu respon awal &lt; 2 jam</span>
          </div>
        </div>

        <!-- Card 3: Diproses (Biru) -->
        <div class="metric-card panel status-card-blue" data-filter-status="Diproses">
          <div class="metric-icon blue-bg">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">Sedang Diproses</span>
            <div class="metric-value blue-text" id="countDiproses">{counts.diproses}</div>
            <span class="metric-hint">Satgas/DLH di lapangan</span>
          </div>
        </div>

        <!-- Card 4: Selesai (Hijau) -->
        <div class="metric-card panel status-card-green" data-filter-status="Selesai">
          <div class="metric-icon green-bg">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">Tuntas / Selesai</span>
            <div class="metric-value green-text" id="countSelesai">{counts.selesai}</div>
            <span class="metric-hint">Masalah tertangani tuntas</span>
          </div>
        </div>

        <!-- Card 5: Ditolak (Merah) -->
        <div class="metric-card panel status-card-red" data-filter-status="Ditolak">
          <div class="metric-icon red-bg">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">Ditolak / Invalid</span>
            <div class="metric-value red-text" id="countDitolak">{counts.ditolak}</div>
            <span class="metric-hint">Fiktif / tanpa bukti valid</span>
          </div>
        </div>
      </section>

      <!-- Main Panel: Data Filter & Interactive Controls -->
      <section class="admin-main-section panel">
        <!-- Control Bar: Search, Filters, View Switcher -->
        <div class="controls-toolbar">
          <!-- Search Box -->
          <div class="search-box-wrapper">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="search-icon">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input
              id="reportSearchInput"
              type="search"
              placeholder="Cari pelapor, jalan, kecamatan, judul, ID..."
              autocomplete="off"
            />
            <button id="clearSearchBtn" class="clear-search-btn hide" title="Bersihkan pencarian">✕</button>
          </div>

          <!-- Dropdown Filter: Status -->
          <div class="filter-group">
            <label for="filterStatusSelect" class="sr">Filter Status</label>
            <select id="filterStatusSelect" class="filter-select">
              <option value="">Semua Status</option>
              <option value="Menunggu">🟡 Menunggu</option>
              <option value="Diproses">🔵 Diproses</option>
              <option value="Selesai">🟢 Selesai</option>
              <option value="Ditolak">🔴 Ditolak</option>
            </select>
          </div>

          <!-- Dropdown Filter: Kategori -->
          <div class="filter-group">
            <label for="filterCategorySelect" class="sr">Filter Kategori</label>
            <select id="filterCategorySelect" class="filter-select">
              <option value="">Semua Kategori</option>
              {categories.map((cat) => (
                <option value={cat}>{cat}</option>
              ))}
            </select>
          </div>

          <!-- Dropdown Filter: Urgensi -->
          <div class="filter-group">
            <label for="filterUrgencySelect" class="sr">Filter Urgensi</label>
            <select id="filterUrgencySelect" class="filter-select">
              <option value="">Semua Urgensi</option>
              <option value="Kritis">🔥 Kritis</option>
              <option value="Tinggi">⚡ Tinggi</option>
              <option value="Sedang">⚠️ Sedang</option>
              <option value="Normal">🟢 Normal</option>
            </select>
          </div>

          <!-- View Mode Toggle: Table vs Cards -->
          <div class="view-toggle-group">
            <button id="btnViewTable" class="view-btn active" title="Tampilan Tabel Data">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
              </svg>
              <span>Tabel</span>
            </button>
            <button id="btnViewCards" class="view-btn" title="Tampilan Kartu Grid">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
              </svg>
              <span>Grid Kartu</span>
            </button>
          </div>

          <button id="btnResetFilters" class="btn-reset-filters hide" title="Reset semua filter">
            <span>Reset</span>
          </button>
        </div>

        <!-- Filter Status Bar -->
        <div class="results-status-bar">
          <div class="results-count">
            Menampilkan <strong id="visibleCount">{reports.length}</strong> dari <span>{reports.length}</span> laporan
          </div>
          <div id="activeFilterTags" class="active-filter-tags"></div>
        </div>

        <!-- View 1: Data Table View -->
        <div id="tableViewContainer" class="table-view-wrap">
          <div class="table-responsive">
            <table class="data-table" id="reportsTable">
              <thead>
                <tr>
                  <th style="width: 110px;">ID Laporan</th>
                  <th style="width: 140px;">Tanggal Kirim</th>
                  <th>Pelapor & Kontak</th>
                  <th>Kategori</th>
                  <th>Judul & Lokasi</th>
                  <th style="width: 90px;">Urgensi</th>
                  <th style="width: 130px;">Status Saat Ini</th>
                  <th style="width: 160px;">Ubah Status Cepat</th>
                  <th style="width: 110px; text-align: center;">Aksi</th>
                </tr>
              </thead>
              <tbody id="tableBody">
                {reports.map((rep) => {
                  const dateObj = new Date(rep.created_at);
                  const formattedDate = !isNaN(dateObj.getTime())
                    ? dateObj.toLocaleDateString('id-ID', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      }) + ', ' + dateObj.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB'
                    : rep.created_at;

                  const cleanPhone = String(rep.whatsapp || rep.kontak || '').replace(/[^0-9]/g, '');

                  return (
                    <tr
                      class="report-row"
                      id={`row-${rep.id}`}
                      data-id={rep.id}
                      data-nama={rep.nama_pelapor.toLowerCase()}
                      data-lokasi={rep.lokasi.toLowerCase()}
                      data-kecamatan={rep.kecamatan.toLowerCase()}
                      data-kategori={rep.kategori}
                      data-urgensi={rep.urgensi}
                      data-status={rep.status}
                      data-judul={rep.judul.toLowerCase()}
                      data-deskripsi={rep.deskripsi.toLowerCase()}
                    >
                      <!-- ID Laporan -->
                      <td>
                        <span class="report-id-badge">{rep.id}</span>
                      </td>

                      <!-- Tanggal Kirim -->
                      <td class="cell-date">
                        <span>{formattedDate}</span>
                      </td>

                      <!-- Pelapor & Kontak -->
                      <td>
                        <div class="reporter-info">
                          <strong class="reporter-name">{rep.nama_pelapor}</strong>
                          {rep.email && <span class="reporter-email">{rep.email}</span>}
                          {cleanPhone ? (
                            <a
                              href={`https://wa.me/${cleanPhone.startsWith('0') ? '62' + cleanPhone.slice(1) : cleanPhone}?text=Halo%20${encodeURIComponent(rep.nama_pelapor)}%2C%20kami%20dari%20Admin%20Cangkruk%20Hijau%20Surabaya%20terkait%20laporan%20${encodeURIComponent(rep.id)}.`}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="wa-quick-link"
                              title="Hubungi via WhatsApp"
                            >
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
                              </svg>
                              <span>{rep.whatsapp || rep.kontak}</span>
                            </a>
                          ) : (
                            <span class="contact-pill">{rep.kontak}</span>
                          )}
                        </div>
                      </td>

                      <!-- Kategori Laporan -->
                      <td>
                        <span class="category-pill">{rep.kategori}</span>
                      </td>

                      <!-- Judul & Lokasi -->
                      <td class="cell-title-loc">
                        <div class="report-title-text" title={rep.judul}>
                          {rep.judul}
                        </div>
                        <div class="report-loc-snippet">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pin-icon">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                          </svg>
                          <span>{rep.lokasi}</span>
                        </div>
                      </td>

                      <!-- Urgensi -->
                      <td>
                        <span class={`urgency-badge ${rep.urgensi === 'Kritis' ? 'critical' : rep.urgensi === 'Tinggi' ? 'high' : rep.urgensi === 'Sedang' ? 'medium' : 'normal'}`}>
                          {rep.urgensi}
                        </span>
                      </td>

                      <!-- Status Saat Ini (Badge Warna) -->
                      <td>
                        <span class={`status-badge-main status-${rep.status.toLowerCase()}`} id={`status-badge-${rep.id}`}>
                          <span class="status-dot"></span>
                          <span class="status-text">{rep.status}</span>
                        </span>
                      </td>

                      <!-- Kontrol Perubahan Status Operasional -->
                      <td>
                        <div class="status-action-wrap">
                          <select
                            class="status-changer-select"
                            data-report-id={rep.id}
                            title="Ubah status laporan dan simpan ke Supabase"
                          >
                            <option value="Menunggu" selected={rep.status === 'Menunggu'}>🟡 Menunggu</option>
                            <option value="Diproses" selected={rep.status === 'Diproses'}>🔵 Diproses</option>
                            <option value="Selesai" selected={rep.status === 'Selesai'}>🟢 Selesai</option>
                            <option value="Ditolak" selected={rep.status === 'Ditolak'}>🔴 Ditolak</option>
                          </select>
                          <span class="status-spin hide" id={`spin-${rep.id}`}>⏳</span>
                        </div>
                      </td>

                      <!-- Tombol Lihat Detail -->
                      <td style="text-align: center;">
                        <button
                          type="button"
                          class="btn-detail-trigger"
                          data-report-json={JSON.stringify(rep)}
                          title="Buka modal detail lengkap"
                        >
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                          </svg>
                          <span>Detail</span>
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <!-- View 2: Cards Grid View -->
        <div id="cardsViewContainer" class="cards-view-wrap hide">
          <div class="reports-cards-grid">
            {reports.map((rep) => {
              const dateObj = new Date(rep.created_at);
              const formattedDate = !isNaN(dateObj.getTime())
                ? dateObj.toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                  })
                : rep.created_at;

              const cleanPhone = String(rep.whatsapp || rep.kontak || '').replace(/[^0-9]/g, '');

              return (
                <div
                  class="report-card panel"
                  id={`card-${rep.id}`}
                  data-id={rep.id}
                  data-nama={rep.nama_pelapor.toLowerCase()}
                  data-lokasi={rep.lokasi.toLowerCase()}
                  data-kecamatan={rep.kecamatan.toLowerCase()}
                  data-kategori={rep.kategori}
                  data-urgensi={rep.urgensi}
                  data-status={rep.status}
                  data-judul={rep.judul.toLowerCase()}
                  data-deskripsi={rep.deskripsi.toLowerCase()}
                >
                  <!-- Card Header -->
                  <div class="card-head">
                    <div>
                      <span class="report-id-badge">{rep.id}</span>
                      <span class="card-date-badge">{formattedDate}</span>
                    </div>
                    <span class={`status-badge-main status-${rep.status.toLowerCase()}`} id={`card-status-badge-${rep.id}`}>
                      <span class="status-dot"></span>
                      <span class="status-text">{rep.status}</span>
                    </span>
                  </div>

                  <!-- Card Photo / Thumbnail -->
                  {rep.foto_url ? (
                    <div class="card-thumb-wrap">
                      <img src={rep.foto_url} alt={`Bukti ${rep.judul}`} class="card-thumb-img" loading="lazy" />
                      <span class="thumb-badge">📷 Ada Lampiran Foto</span>
                    </div>
                  ) : (
                    <div class="card-thumb-placeholder">
                      <span>📄 Tanpa Lampiran Foto</span>
                    </div>
                  )}

                  <!-- Card Content -->
                  <div class="card-body">
                    <div class="card-cat-urgency">
                      <span class="category-pill">{rep.kategori}</span>
                      <span class={`urgency-badge ${rep.urgensi === 'Kritis' ? 'critical' : rep.urgensi === 'Tinggi' ? 'high' : rep.urgensi === 'Sedang' ? 'medium' : 'normal'}`}>
                        {rep.urgensi}
                      </span>
                    </div>

                    <h3 class="card-title">{rep.judul}</h3>
                    <p class="card-desc-snippet">{rep.deskripsi}</p>

                    <!-- Lokasi & Pelapor -->
                    <div class="card-meta">
                      <div class="meta-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                        </svg>
                        <span>{rep.lokasi}</span>
                      </div>
                      <div class="meta-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                        <strong>{rep.nama_pelapor}</strong>
                        {cleanPhone && (
                          <a
                            href={`https://wa.me/${cleanPhone.startsWith('0') ? '62' + cleanPhone.slice(1) : cleanPhone}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="wa-icon-link"
                            title="Chat WhatsApp"
                          >
                            💬
                          </a>
                        )}
                      </div>
                    </div>
                  </div>

                  <!-- Card Footer / Actions -->
                  <div class="card-footer">
                    <div class="card-status-select-wrap">
                      <select
                        class="status-changer-select"
                        data-report-id={rep.id}
                        title="Ubah status operasional laporan"
                      >
                        <option value="Menunggu" selected={rep.status === 'Menunggu'}>🟡 Menunggu</option>
                        <option value="Diproses" selected={rep.status === 'Diproses'}>🔵 Diproses</option>
                        <option value="Selesai" selected={rep.status === 'Selesai'}>🟢 Selesai</option>
                        <option value="Ditolak" selected={rep.status === 'Ditolak'}>🔴 Ditolak</option>
                      </select>
                    </div>
                    <button
                      type="button"
                      class="btn-detail-trigger card-btn-detail"
                      data-report-json={JSON.stringify(rep)}
                    >
                      <span>Lihat Detail</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"/>
                      </svg>
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Empty State (When Filter yields 0 results) -->
        <div id="noResultsState" class="empty-results-box hide">
          <div class="empty-icon">🔍</div>
          <h3>Tidak Ditemukan Laporan yang Cocok</h3>
          <p>Coba gunakan kata kunci pencarian yang berbeda atau reset filter status dan kategori Anda.</p>
          <button id="btnEmptyReset" class="btn-primary-reset">Reset Semua Filter</button>
        </div>
      </section>
    </div>
  </main>

