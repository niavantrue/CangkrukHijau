---
import Layout from '../../layouts/Layout.astro';

const user = Astro.locals.user;

// Jika sudah login dan memiliki akses admin, langsung redirect ke dashboard admin
if (user) {
  // Jika user sudah terautentikasi
  return Astro.redirect('/admin/dashboard');
}
---

<Layout
  title="Portal Masuk Administrator | Cangkruk Hijau"
  description="Portal otentikasi khusus administrator dan pengelola Cangkruk Hijau Surabaya."
  activeNav="admin-login"
  lang="id"
>
  <main class="admin-login-page">
    <div class="wrap admin-wrap">
      <div class="admin-panel panel">
        <div class="admin-badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
          </svg>
          <span>PORTAL KHUSUS ADMIN</span>
        </div>

        <h1 class="title" style="font-size: 28px; margin-top: 14px; text-align: center;">
          Login Administrator
        </h1>
        <p class="intro" style="font-size: 14px; text-align: center; margin-top: 6px; color: var(--muted);">
          Masuk untuk mengelola data laporan warga, keanggotaan komunitas, dan pendaftaran peserta FGD.
        </p>

        <div id="adminAuthAlert" class="auth-alert hide" role="alert"></div>

        <form id="adminLoginForm" class="auth-form" style="margin-top: 24px;">
          <div class="field">
            <label for="adminEmail">Email Administrator</label>
            <input
              id="adminEmail"
              name="email"
              type="email"
              placeholder="admin@cangkruk.id atau email admin"
              autocomplete="email"
              required
            />
          </div>

          <div class="field">
            <label for="adminPassword">Kata Sandi</label>
            <input
              id="adminPassword"
              name="password"
              type="password"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            />
          </div>

          <div class="admin-hint">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <span>Gunakan akun terdaftar pengelola Cangkruk Hijau.</span>
          </div>

          <button id="adminSubmitBtn" class="submit auth-btn" type="submit">
            <span class="btn-text">Masuk ke Dashboard Admin</span>
            <span class="btn-spinner hide">Memvalidasi...</span>
          </button>
        </form>

        <div class="admin-footer">
          <a href="/">← Kembali ke Portal Warga / Beranda</a>
        </div>
      </div>
    </div>
  </main>

  <style>
    .admin-login-page {
      padding: 60px 0 90px;
      min-height: 75vh;
      display: flex;
      align-items: center;
      background: radial-gradient(circle at top right, #edf6ea 0%, var(--cream) 60%);
    }
    .admin-wrap {
      max-width: 480px;
      width: 100%;
    }
    .admin-panel {
      padding: 40px 32px;
      border: 1px solid var(--line);
      border-radius: var(--r);
      box-shadow: var(--shadow-lg);
      background: #FFFFFF;
    }
    .admin-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #0E3A21;
      color: #8FCBA3;
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 0.08em;
      padding: 6px 12px;
      border-radius: 100px;
      margin: 0 auto;
      display: table;
    }
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .admin-hint {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      color: var(--muted);
      background: var(--g50);
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid var(--line);
    }
    .auth-btn {
      width: 100%;
      margin-top: 6px;
      padding: 14px 20px;
      font-size: 15px;
      background: var(--g900);
      color: #FFFFFF;
      border: none;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(14, 58, 33, 0.25);
      transition: background-color 0.15s, transform 0.15s;
    }
    .auth-btn:hover {
      background: #155732;
      transform: translateY(-1px);
    }
    .admin-footer {
      margin-top: 24px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      text-align: center;
      font-size: 13.5px;
    }
    .admin-footer a {
      color: var(--g700);
      font-weight: 700;
    }
    .admin-footer a:hover {
      color: var(--pink);
    }
    .auth-alert {
      padding: 12px 16px;
      border-radius: var(--r-sm);
      font-size: 13.5px;
      font-weight: 600;
      margin-top: 16px;
    }
    .auth-alert.error {
      background: #FDE8E8;
      border: 1px solid #F8B4B4;
      color: #9B1C1C;
    }
    .auth-alert.success {
      background: #DEF7EC;
      border: 1px solid #BCF0DA;
      color: #03543F;
    }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';

    const form = document.getElementById('adminLoginForm') as HTMLFormElement | null;
    const alertBox = document.getElementById('adminAuthAlert');
    const submitBtn = document.getElementById('adminSubmitBtn') as HTMLButtonElement | null;
    const btnText = submitBtn?.querySelector('.btn-text');
    const btnSpinner = submitBtn?.querySelector('.btn-spinner');

    function showAlert(message: string, type: 'error' | 'success') {
      if (!alertBox) return;
      alertBox.textContent = message;
      alertBox.className = `auth-alert ${type}`;
      alertBox.classList.remove('hide');
    }

    function setLoading(isLoading: boolean) {
      if (!submitBtn) return;
      submitBtn.disabled = isLoading;
      if (isLoading) {
        btnText?.classList.add('hide');
        btnSpinner?.classList.remove('hide');
      } else {
        btnText?.classList.remove('hide');
        btnSpinner?.classList.add('hide');
      }
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('adminEmail') as HTMLInputElement)?.value.trim();
        const password = (document.getElementById('adminPassword') as HTMLInputElement)?.value;

        if (!email || !password) {
          showAlert('Harap masukkan email dan kata sandi administrator.', 'error');
          return;
        }

        setLoading(true);
        if (alertBox) alertBox.classList.add('hide');

        try {
          const { data, error } = await supabase.auth.signInWithPassword({
            email,
            password,
          });

          if (error) {
            let errorMsg = error.message;
            if (errorMsg.includes('Invalid login credentials')) {
              errorMsg = 'Kredensial login administrator tidak sesuai.';
            }
            showAlert(errorMsg, 'error');
            setLoading(false);
            return;
          }

          showAlert('Autentikasi admin berhasil! Mengalihkan ke dashboard...', 'success');
          setTimeout(() => {
            window.location.href = '/admin/dashboard';
          }, 600);
        } catch (err: any) {
          showAlert(err?.message || 'Terjadi kesalahan sistem.', 'error');
          setLoading(false);
        }
      });
    }
  </script>
</Layout>
