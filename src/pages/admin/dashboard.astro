---
import Layout from '../../layouts/Layout.astro';
import { fgdAgendas } from '../../data/fgd.js';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

// Proteksi halaman: jika belum login, arahkan ke /admin/login
if (!user) {
  return Astro.redirect('/admin/login');
}

// Data Default / Fallback Laporan Warga
const initialReports = [
  {
    id: 'LAP-2026-001',
    nama: 'Bambang Sudibyo',
    lokasi: 'Bantaran Kali Jagir, Wonokromo, Surabaya',
    deskripsi: 'Penumpukan sampah rumah tangga dan limbah plastik di tepi pintu air hilir.',
    kontak: '081239847112',
    tanggal: '23 Mar 2026',
    status: 'Dalam Investigasi',
    urgensi: 'Tinggi',
  },
  {
    id: 'LAP-2026-002',
    nama: 'Siti Nurjanah',
    lokasi: 'Kawasan Wisata Kenjeran Baru, Bulak, Surabaya',
    deskripsi: 'Pembakaran sampah kabel terbuka di lahan kosong yang menimbulkan asap pekat berbau kimia.',
    kontak: '085721980344',
    tanggal: '22 Mar 2026',
    status: 'Ditindaklanjuti',
    urgensi: 'Tinggi',
  },
  {
    id: 'LAP-2026-003',
    nama: 'Relawan Hijau Rungkut',
    lokasi: 'Kawasan Sabuk Hijau Pamurbaya, Gunung Anyar',
    deskripsi: 'Penebangan liar beberapa rumpun pohon mangrove dewasa untuk perluasan tambak liar.',
    kontak: '088127371159',
    tanggal: '20 Mar 2026',
    status: 'Selesai / Terverifikasi',
    urgensi: 'Kritis',
  },
  {
    id: 'LAP-2026-004',
    nama: 'Ahmad Fauzi',
    lokasi: 'Taman Prestasi Surabaya, Ketabang, Genteng',
    deskripsi: 'Fasilitas tempat sampah terpilah rusak dan saluran drainase taman tersumbat dedaunan.',
    kontak: '081398765432',
    tanggal: '18 Mar 2026',
    status: 'Ditindaklanjuti',
    urgensi: 'Sedang',
  },
];

// Data Default / Fallback Pendaftar FGD
const initialFgdRegistrations = [
  {
    id: 'REG-FGD-01',
    full_name: 'Anisa Putri Maharani',
    email: 'anisa.putri@its.ac.id',
    institution: 'Departemen Teknik Lingkungan ITS',
    whatsapp: '081245678901',
    agenda_title: 'Restorasi & Mitigasi Abrasi Kawasan Pesisir Pamurbaya',
    created_at: '2026-03-24T10:15:00Z',
    motivation: 'Ingin berkolaborasi dalam pemetaan zonasi suaka burung air dan mangrove.',
  },
  {
    id: 'REG-FGD-02',
    full_name: 'Dimas Wicaksono',
    email: 'dimas.wicak@ecoton.id',
    institution: 'Ecoton Water Watcher',
    whatsapp: '085678912345',
    agenda_title: 'Audit Kualitas Air dan Pengendalian Limbah Mikroplastik Kali Surabaya',
    created_at: '2026-03-23T14:30:00Z',
    motivation: 'Menyampaikan data riset kandungan partikel polimer sintetis di muara Wonokromo.',
  },
  {
    id: 'REG-FGD-03',
    full_name: 'Ratna Sulistiyowati',
    email: 'ratna.bank.sampah@gmail.com',
    institution: 'Bank Sampah Bintang Mangrove Rungkut',
    whatsapp: '087812349000',
    agenda_title: 'Optimalisasi Sirkular Ekonomi Sampah Organik Menuju Zero Waste City',
    created_at: '2026-03-22T09:00:00Z',
    motivation: 'Mendorong integrasi bank sampah unit dengan program RDF dan maggot kota.',
  },
  {
    id: 'REG-FGD-04',
    full_name: 'Faris Pratama',
    email: 'faris.pratama@surabaya.go.id',
    institution: 'Kader Surabaya Hebat (KSH) Sawahan',
    whatsapp: '081987654321',
    agenda_title: 'Ekspansi Ruang Terbuka Hijau (RTH) dan Ketahanan Pangan Berbasis Lorong',
    created_at: '2026-03-21T16:45:00Z',
    motivation: 'Berbagi pengalaman penataan pot lorong herbal dan hidroponik kampung.',
  },
];

let fgdRegistrations = initialFgdRegistrations;
let citizenReports = initialReports;
let totalCommunities = 14; // default registered environmental communities
let totalFgdRegistrationsCount = fgdRegistrations.length;
let totalReportsCount = citizenReports.length;

// Ambil data real dari Supabase jika tersedia
if (supabase) {
  try {
    // 1. Ambil pendaftar FGD dari tabel fgd_registrations
    const { data: dbFgdRegs, error: fgdErr } = await supabase
      .from('fgd_registrations')
      .select('*')
      .order('created_at', { ascending: false });

    if (dbFgdRegs && dbFgdRegs.length > 0) {
      fgdRegistrations = dbFgdRegs;
      totalFgdRegistrationsCount = dbFgdRegs.length;
    }

    // 2. Ambil total komunitas terdaftar dari user_communities
    const { count: commCount, error: commErr } = await supabase
      .from('user_communities')
      .select('*', { count: 'exact', head: true });

    if (typeof commCount === 'number' && commCount > 0) {
      totalCommunities = Math.max(commCount, 14);
    }

    // 3. Ambil laporan warga jika ada tabel citizen_reports
    const { data: dbReports, error: repErr } = await supabase
      .from('citizen_reports')
      .select('*')
      .order('created_at', { ascending: false });

    if (dbReports && dbReports.length > 0) {
      citizenReports = dbReports;
      totalReportsCount = dbReports.length;
    }
  } catch (e) {
    // Gunakan initial data
  }
}

const adminEmail = user.email || 'admin@cangkruk.id';
---

<Layout
  title="Dashboard Administrator | Cangkruk Hijau"
  description="Panel Pengawasan & Manajemen Data: Laporan Warga, Keanggotaan Komunitas, dan Pendaftaran FGD Lingkungan Surabaya."
  activeNav="admin-dashboard"
  lang="id"
>
  <main class="admin-dashboard">
    <div class="wrap">
      <!-- Top Navigation / Header -->
      <div class="admin-top-bar panel">
        <div class="admin-user-info">
          <div class="admin-avatar">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
            </svg>
          </div>
          <div>
            <div class="admin-badge-sm">PORTAL ADMINISTRATOR</div>
            <h1 class="admin-title">Pusat Kendali Cangkruk Hijau</h1>
            <p class="admin-sub">Login sebagai: <strong>{adminEmail}</strong></p>
          </div>
        </div>

        <div class="admin-header-actions">
          <a href="/" class="btn-portal-client" target="_blank">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            <span>Buka Portal Publik</span>
          </a>
          <form action="/api/auth/logout" method="POST" style="display:inline; margin:0;">
            <button type="submit" class="btn-admin-logout" title="Keluar dari Portal Admin">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              <span>Keluar Admin</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Metric Stats Cards -->
      <section class="admin-metrics-grid">
        <!-- Metrik 1: Total Laporan Warga -->
        <div class="metric-card panel">
          <div class="metric-icon red-bg">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">Laporan Pengaduan Warga</span>
            <div class="metric-value">{totalReportsCount}</div>
            <span class="metric-hint positive">● Membutuhkan Pemantauan Cepat</span>
          </div>
        </div>

        <!-- Metrik 2: Total Komunitas Terdaftar -->
        <div class="metric-card panel">
          <div class="metric-icon green-bg">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
              <circle cx="8" cy="8" r="3.4"/>
              <circle cx="16.5" cy="9.5" r="2.8"/>
              <path d="M2 20c0-3.4 2.7-5.6 6-5.6s6 2.2 6 5.6Z"/>
              <path d="M14.6 20c0-2.6 1.6-4.4 4-4.4 2.2 0 3.4 1.6 3.4 4.4Z"/>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">Total Komunitas Lingkungan</span>
            <div class="metric-value">{totalCommunities}</div>
            <span class="metric-hint">● Surabaya & Jawa Timur</span>
          </div>
        </div>

        <!-- Metrik 3: Total Pendaftar FGD -->
        <div class="metric-card panel">
          <div class="metric-icon purple-bg">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">Pendaftar Agenda FGD</span>
            <div class="metric-value">{totalFgdRegistrationsCount}</div>
            <span class="metric-hint">● Dari 4 Agenda Publik</span>
          </div>
        </div>
      </section>

      <!-- Tables Section -->
      <div class="admin-tables-container">
        <!-- Table 1: Pendaftar FGD Terbaru -->
        <section class="admin-section panel">
          <div class="section-header">
            <div>
              <h2 class="section-title">
                <span class="bullet purple"></span> Pendaftar Agenda FGD Terbaru
              </h2>
              <p class="section-desc">Data peserta yang mendaftar melalui formulir publik `fgd_registrations`.</p>
            </div>
            <span class="badge-count">{fgdRegistrations.length} Peserta</span>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Nama Lengkap</th>
                  <th>Instansi / Komunitas</th>
                  <th>Email</th>
                  <th>WhatsApp</th>
                  <th>Agenda FGD</th>
                  <th>Tanggal Daftar</th>
                </tr>
              </thead>
              <tbody>
                {fgdRegistrations.map((reg: any) => {
                  const regDate = reg.created_at
                    ? new Date(reg.created_at).toLocaleDateString('id-ID', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                      })
                    : '-';

                  return (
                    <tr>
                      <td class="cell-primary">
                        <strong>{reg.full_name}</strong>
                      </td>
                      <td>
                        <span class="inst-pill">{reg.institution || 'Umum'}</span>
                      </td>
                      <td>
                        <a href={`mailto:${reg.email}`} class="table-link">{reg.email}</a>
                      </td>
                      <td>
                        <a
                          href={`https://wa.me/${String(reg.whatsapp).replace(/[^0-9]/g, '')}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="table-wa-link"
                        >
                          {reg.whatsapp}
                        </a>
                      </td>
                      <td class="cell-agenda">
                        <span title={reg.agenda_title}>{reg.agenda_title || 'Diskusi Lingkungan'}</span>
                      </td>
                      <td class="cell-date">{regDate}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Table 2: Laporan Warga Terbaru -->
        <section class="admin-section panel">
          <div class="section-header">
            <div>
              <h2 class="section-title">
                <span class="bullet red"></span> Daftar Pengaduan & Laporan Warga
              </h2>
              <p class="section-desc">Pengaduan kerusakan dan pencemaran lingkungan yang masuk dari warga Surabaya.</p>
            </div>
            <span class="badge-count">{citizenReports.length} Laporan Masuk</span>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Pelapor</th>
                  <th>Lokasi Pelanggaran</th>
                  <th>Ringkasan Masalah</th>
                  <th>Kontak</th>
                  <th>Urgensi</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {citizenReports.map((rep: any) => (
                  <tr>
                    <td class="cell-primary">
                      <strong>{rep.nama}</strong>
                    </td>
                    <td>
                      <span class="loc-text">{rep.lokasi}</span>
                    </td>
                    <td class="cell-desc">
                      <p>{rep.deskripsi}</p>
                    </td>
                    <td>
                      <span class="contact-pill">{rep.kontak || '-'}</span>
                    </td>
                    <td>
                      <span class={`urgency-badge ${rep.urgensi === 'Kritis' ? 'critical' : rep.urgensi === 'Tinggi' ? 'high' : 'medium'}`}>
                        {rep.urgensi || 'Normal'}
                      </span>
                    </td>
                    <td>
                      <span class="status-tag verified">{rep.status || 'Tercatat'}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </main>

  <style>
    .admin-dashboard {
      padding: 36px 0 80px;
      background: #F4F7F2;
      min-height: 85vh;
    }
    .admin-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
      padding: 24px 30px;
      background: #FFFFFF;
      border: 1px solid var(--line);
      border-radius: var(--r);
      box-shadow: var(--shadow);
    }
    .admin-user-info {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .admin-avatar {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: #0E3A21;
      color: #8FCBA3;
      display: grid;
      place-items: center;
      flex: none;
    }
    .admin-badge-sm {
      font-size: 11px;
      font-weight: 800;
      color: var(--g700);
      letter-spacing: 0.08em;
    }
    .admin-title {
      font-size: 24px;
      color: var(--g900);
      margin-top: 2px;
    }
    .admin-sub {
      font-size: 13.5px;
      color: var(--muted);
      margin-top: 2px;
    }
    .admin-header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .btn-portal-client {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--g50);
      border: 1px solid var(--line);
      color: var(--g700);
      font-size: 13.5px;
      font-weight: 700;
      padding: 10px 16px;
      border-radius: 10px;
      transition: background 0.15s;
    }
    .btn-portal-client:hover {
      background: var(--g100);
    }
    .btn-admin-logout {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #FDE8E8;
      border: 1px solid #F8B4B4;
      color: #9B1C1C;
      font-size: 13.5px;
      font-weight: 700;
      padding: 10px 16px;
      border-radius: 10px;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-admin-logout:hover {
      background: #F8B4B4;
    }

    /* Metrics Grid */
    .admin-metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 28px;
    }
    .metric-card {
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 24px;
      background: #FFFFFF;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      box-shadow: var(--shadow);
    }
    .metric-icon {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      display: grid;
      place-items: center;
      flex: none;
    }
    .metric-icon.red-bg {
      background: #FDE8E8;
      color: #E02424;
    }
    .metric-icon.green-bg {
      background: #DEF7EC;
      color: #0E9F6E;
    }
    .metric-icon.purple-bg {
      background: #EDE4FA;
      color: #8256C4;
    }
    .metric-details {
      display: flex;
      flex-direction: column;
    }
    .metric-label {
      font-size: 13px;
      color: var(--muted);
      font-weight: 600;
    }
    .metric-value {
      font-family: var(--logo);
      font-size: 32px;
      font-weight: 800;
      color: var(--g900);
      line-height: 1.1;
      margin: 4px 0 2px;
    }
    .metric-hint {
      font-size: 12px;
      color: var(--muted);
      font-weight: 600;
    }
    .metric-hint.positive {
      color: #E02424;
    }

    /* Tables */
    .admin-tables-container {
      display: flex;
      flex-direction: column;
      gap: 32px;
      margin-top: 32px;
    }
    .admin-section {
      background: #FFFFFF;
      border: 1px solid var(--line);
      border-radius: var(--r);
      padding: 28px;
      box-shadow: var(--shadow);
    }
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .section-title {
      font-size: 19px;
      color: var(--g900);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-desc {
      font-size: 13.5px;
      color: var(--muted);
      margin-top: 4px;
    }
    .bullet {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }
    .bullet.purple {
      background: #8256C4;
    }
    .bullet.red {
      background: #E02424;
    }
    .badge-count {
      background: var(--g50);
      border: 1px solid var(--line);
      color: var(--g700);
      font-size: 12.5px;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 100px;
    }
    .table-responsive {
      overflow-x: auto;
      border-radius: 12px;
      border: 1px solid var(--line);
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13.5px;
    }
    .data-table th {
      background: #F8FAF7;
      color: var(--g900);
      font-weight: 700;
      padding: 14px 16px;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    .data-table td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--line);
      color: var(--text);
      vertical-align: middle;
    }
    .data-table tbody tr:last-child td {
      border-bottom: none;
    }
    .data-table tbody tr:hover {
      background: #FDFEFD;
    }
    .cell-primary {
      color: var(--g900);
    }
    .inst-pill {
      background: #F3F4F6;
      color: #374151;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
    }
    .table-link {
      color: var(--g700);
      text-decoration: underline;
    }
    .table-wa-link {
      color: #057A55;
      font-weight: 700;
    }
    .cell-agenda {
      max-width: 260px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--muted);
      font-weight: 500;
    }
    .cell-date {
      color: var(--muted);
      white-space: nowrap;
      font-size: 12.5px;
    }
    .loc-text {
      font-size: 13px;
      color: #374151;
      max-width: 200px;
      display: inline-block;
    }
    .cell-desc {
      max-width: 300px;
    }
    .cell-desc p {
      margin: 0;
      font-size: 13px;
      color: var(--muted);
      line-height: 1.45;
    }
    .contact-pill {
      font-family: monospace;
      font-size: 12.5px;
      color: #4B5563;
    }
    .urgency-badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 11.5px;
      font-weight: 700;
    }
    .urgency-badge.critical {
      background: #FDE8E8;
      color: #9B1C1C;
    }
    .urgency-badge.high {
      background: #FEECDC;
      color: #B43403;
    }
    .urgency-badge.medium {
      background: #FEF08A;
      color: #713F12;
    }
    .status-tag.verified {
      background: #DEF7EC;
      color: #03543F;
      font-size: 12px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 100px;
      white-space: nowrap;
    }
    @media (max-width: 768px) {
      .admin-top-bar {
        flex-direction: column;
        align-items: flex-start;
      }
      .admin-header-actions {
        width: 100%;
        justify-content: flex-start;
      }
    }
  </style>
</Layout>
