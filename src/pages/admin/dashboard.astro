  <script>
    document.querySelectorAll('.dash-status-select').forEach((sel) => {
      sel.addEventListener('change', async (e) => {
        const select = e.target as HTMLSelectElement;
        const reportId = select.getAttribute('data-id');
        const newStatus = select.value;
        if (!reportId || !newStatus) return;

        select.disabled = true;
        try {
          const res = await fetch('/api/admin/reports/update-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: reportId, status: newStatus }),
          });
          const json = await res.json();
          if (!res.ok || json.error) throw new Error(json.error || 'Gagal mengubah status');

          const badge = document.getElementById(`dash-badge-${reportId}`);
          if (badge) {
            badge.className = `status-badge-main status-${newStatus.toLowerCase()}`;
            const txt = badge.querySelector('.status-text');
            if (txt) txt.textContent = newStatus;
          }
        } catch (err: any) {
          alert('Gagal memperbarui status: ' + (err.message || 'Kesalahan jaringan'));
        } finally {
          select.disabled = false;
        }
      });
    });
  </script>
