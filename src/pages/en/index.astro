  <!-- Leaflet CDN JS -->
  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>

  <script define:vars={{ parks: parksData.slice(0, 8) }}>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof L === 'undefined') return;

      const mapContainer = document.getElementById('homeLeafletMap');
      if (!mapContainer) return;

      const map = L.map('homeLeafletMap', {
        center: [-7.285, 112.755],
        zoom: 12,
        scrollWheelZoom: false,
      });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 18,
      }).addTo(map);

      const greenIcon = L.divIcon({
        className: 'custom-leaflet-marker',
        html: `<div style="
          background: #1B6B3A;
          color: white;
          width: 28px;
          height: 28px;
          border-radius: 50% 50% 50% 0;
          transform: rotate(-45deg);
          display: grid;
          place-items: center;
          border: 2px solid white;
          box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        ">
          <span style="transform: rotate(45deg); font-size: 12px;">🌳</span>
        </div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 28],
        popupAnchor: [0, -28],
      });

      const markersMap = {};

      parks.forEach((park) => {
        const popupContent = `
          <div style="font-family: sans-serif; max-width: 220px;">
            <img src="${park.image}" alt="${park.name}" style="width:100%; height:90px; object-fit:cover; border-radius:8px; margin-bottom:6px;" onerror="this.src='/images/brand/logo.svg'" />
            <strong style="font-size:13.5px; color:#0E3A21; display:block;">${park.name}</strong>
            <span style="font-size:11.5px; color:#6B7280;">${park.area} · ${park.hours}</span>
            <div style="margin-top:6px;">
              <a href="${park.mapsUrl}" target="_blank" rel="noopener noreferrer" style="color:#1B6B3A; font-size:11.5px; font-weight:bold; text-decoration:underline;">
                Open in Google Maps →
              </a>
            </div>
          </div>
        `;

        const marker = L.marker([park.lat, park.lng], { icon: greenIcon })
          .addTo(map)
          .bindPopup(popupContent);

        markersMap[park.id] = marker;
      });

      // Bind click on park list
      document.querySelectorAll('.taman-home-item').forEach((item) => {
        item.addEventListener('click', () => {
          const parkId = item.getAttribute('data-id');
          const lat = parseFloat(item.getAttribute('data-lat'));
          const lng = parseFloat(item.getAttribute('data-lng'));

          map.flyTo([lat, lng], 14, { duration: 1 });
          const marker = markersMap[parkId];
          if (marker) {
            setTimeout(() => {
              marker.openPopup();
            }, 500);
          }
        });
      });
    });
  </script>

  <!-- ============ LIVE OMNISEARCH SCRIPT ============ -->
  <script define:vars={{ searchDataset }}>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('heroSearchInput');
      const form = document.getElementById('heroSearchForm');
      const btn = document.getElementById('heroSearchBtn');
      const dropdown = document.getElementById('heroSearchDropdown');
      const resultsContainer = document.getElementById('heroSearchResults');
      const tagChips = document.querySelectorAll('.quick-tag-chip');

      if (!input || !dropdown || !resultsContainer) return;

      function escapeHtml(str) {
        return (str || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function highlightText(text, q) {
        if (!q) return escapeHtml(text);
        const escapedQ = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const regex = new RegExp(`(${escapedQ})`, 'gi');
        return escapeHtml(text).replace(regex, '<mark style="background:#C6F6D5; color:#1B6B3A; font-weight:bold; border-radius:2px; padding:0 2px;">$1</mark>');
      }

      function renderResults(q) {
        const cleanQ = (q || '').trim().toLowerCase();
        if (cleanQ.length < 2) {
          dropdown.hidden = true;
          return;
        }

        const matches = searchDataset.filter((item) => {
          const t = (item.title || '').toLowerCase();
          const s = (item.snippet || '').toLowerCase();
          const m = (item.meta || '').toLowerCase();
          return t.includes(cleanQ) || s.includes(cleanQ) || m.includes(cleanQ);
        });

        if (matches.length === 0) {
          resultsContainer.innerHTML = `
            <div class="search-empty-state">
              <div class="search-empty-icon">🔍</div>
              <div style="font-weight:700; color:#111827; font-size:14px;">No results found for "${escapeHtml(q)}"</div>
              <p style="font-size:12.5px; margin-top:6px; color:#6B7280;">Try generic keywords like <em>mangrove</em>, <em>compost</em>, <em>park</em>, or <em>waste</em>.</p>
            </div>
          `;
          dropdown.hidden = false;
          return;
        }

        // Group by category
        const groups = {};
        matches.forEach((item) => {
          if (!groups[item.group]) {
            groups[item.group] = [];
          }
          groups[item.group].push(item);
        });

        let html = `
          <div class="search-dropdown-header">
            <span>Found ${matches.length} results for "${escapeHtml(q)}"</span>
            <span style="font-size:11px; font-weight:normal; text-transform:none;">Press ESC to close</span>
          </div>
        `;

        Object.keys(groups).forEach((groupName) => {
          const items = groups[groupName];
          html += `<div class="search-group"><div class="search-group-title">${groupName} (${items.length})</div>`;
          items.slice(0, 4).forEach((item) => {
            const imgTag = item.image
              ? `<img class="search-result-thumb" src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy" onerror="this.src='/images/brand/logo.svg'" />`
              : `<div class="search-result-icon">🌿</div>`;

            html += `
              <a class="search-result-item" href="${item.url}">
                ${imgTag}
                <div class="search-result-info">
                  <div class="search-result-title">${highlightText(item.title, q)}</div>
                  <div class="search-result-sub">${item.meta ? `<strong>${escapeHtml(item.meta)}</strong> — ` : ''}${highlightText(item.snippet, q)}</div>
                </div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--g600); flex-shrink:0;">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            `;
          });
          html += `</div>`;
        });

        html += `
          <div class="search-dropdown-footer">
            Explore catalogs: <a href="/berita">News</a> · <a href="/edukasi">Education</a> · <a href="/peta-hijau">Parks Map</a> · <a href="/komunitas">Communities</a>
          </div>
        `;

        resultsContainer.innerHTML = html;
        dropdown.hidden = false;
      }

      input.addEventListener('input', function (e) {
        renderResults(e.target.value);
      });

      input.addEventListener('focus', function (e) {
        if (e.target.value.trim().length >= 2) {
          renderResults(e.target.value);
        }
      });

      // Quick tags click
      tagChips.forEach((chip) => {
        chip.addEventListener('click', function () {
          const query = this.getAttribute('data-query') || '';
          input.value = query;
          input.focus();
          renderResults(query);
        });
      });

      // Navigation handler on submit
      function handleSearchSubmit() {
        const q = input.value.trim();
        if (!q) return;
        const firstItem = resultsContainer.querySelector('.search-result-item');
        if (firstItem && !dropdown.hidden) {
          const href = firstItem.getAttribute('href');
          if (href) {
            window.location.href = href;
            return;
          }
        }
        window.location.href = `/berita?q=${encodeURIComponent(q)}`;
      }

      if (btn) {
        btn.addEventListener('click', handleSearchSubmit);
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          handleSearchSubmit();
        });
      }

      // Close dropdown when clicking outside
      document.addEventListener('click', function (e) {
        const isInside = e.target.closest('#heroSearchWrapper');
        if (!isInside && dropdown) {
          dropdown.hidden = true;
        }
      });

      // Close dropdown on Escape
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && dropdown) {
          dropdown.hidden = true;
        }
      });
    });
  </script>
