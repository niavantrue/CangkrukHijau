---
import Layout from '../layouts/Layout.astro';
import { fgdAgendas } from '../data/fgd.js';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

let agendas = fgdAgendas;

// Query database jika Supabase tersedia
if (supabase) {
  try {
    const { data, error } = await supabase
      .from('fgd_agendas')
      .select('*')
      .order('id', { ascending: true });

    if (data && data.length > 0) {
      // Map data Supabase jika ada kolom yang sedikit berbeda
      agendas = data.map((item: any) => ({
        id: item.id || item.slug,
        title: item.title,
        topic: item.topic || item.theme || 'Isu Lingkungan',
        date: item.date || item.event_date,
        time: item.time || item.event_time || '09:00 WIB',
        location: item.location || 'Surabaya / Hybrid',
        quota: Number(item.quota) || 40,
        registeredCount: Number(item.registered_count || item.registeredCount) || 0,
        status: (item.status === 'Penuh' || item.registered_count >= item.quota) ? 'Penuh' : 'Buka',
        speaker: item.speaker || 'Narasumber Ahli',
        description: item.description || '',
        tags: Array.isArray(item.tags) ? item.tags : (item.tags ? item.tags.split(',') : ['Lingkungan']),
      }));
    }
  } catch (e) {
    // Gunakan fallback fgdAgendas
  }
}

// User default data jika sedang login
const defaultName = user?.user_metadata?.full_name || '';
const defaultEmail = user?.email || '';
---

<Layout
  title="Agenda FGD Lingkungan | Cangkruk Hijau"
  description="Ruang rembuk deliberatif dan Focus Group Discussion (FGD) warga, akademisi, dan komunitas untuk merumuskan aksi nyata perlindungan lingkungan di Surabaya."
  activeNav="fgd"
  lang="id"
>
  <main class="fgd-page">
    <!-- Hero Section -->
    <section class="fgd-hero">
      <div class="wrap">
        <div class="hero-content">
          <div class="eyebrow" style="display: inline-flex; align-items: center; gap: 8px;">
            <span class="pulse-dot"></span> Focus Group Discussion (FGD)
          </div>
          <h1 class="title fgd-hero-title">
            Rembuk Warga, Rancang Solusi Hijau Surabaya
          </h1>
          <p class="intro fgd-hero-intro">
            Cangkruk Hijau menghadirkan forum diskusi terarah yang mempertemukan komunitas akar rumput, akademisi, praktisi lingkungan, dan pemangku kebijakan. Bersama merumuskan rekomendasi kebijakan dan aksi lapangan berbasis data.
          </p>

          <div class="hero-stats">
            <div class="stat-pill">
              <span class="num">4+</span>
              <span class="lbl">Topik Strategis</span>
            </div>
            <div class="stat-pill">
              <span class="num">100%</span>
              <span class="lbl">Gratis & Inklusif</span>
            </div>
            <div class="stat-pill">
              <span class="num">Hybrid</span>
              <span class="lbl">Luring & Online</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Grid Section -->
    <section class="wrap fgd-grid-section">
      <div class="shead">
        <div>
          <div class="stitle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
            </svg>
            Jadwal Diskusi & Pendaftaran Peserta
          </div>
          <p style="color: var(--muted); font-size: 14.5px; margin-top: 4px;">
            Pilih agenda diskusi yang sesuai dengan minat advokasi dan kepedulian Anda. Kuota peserta dibatasi agar diskusi tetap interaktif dan solutif.
          </p>
        </div>
        <span class="count">{agendas.length} Agenda Tersedia</span>
      </div>

      <!-- Agenda Cards -->
      <div class="fgd-cards-grid">
        {agendas.map((item) => {
          const isOpen = item.status === 'Buka';
          const percentQuota = Math.min(100, Math.round((item.registeredCount / item.quota) * 100));

          return (
            <article class="fgd-card panel" data-id={item.id} data-title={item.title}>
              <div class="fgd-card-header">
                <div class="topic-badge">{item.topic}</div>
                <div class={`status-pill ${isOpen ? 'open' : 'full'}`}>
                  <span class="status-dot"></span>
                  {isOpen ? 'Pendaftaran Buka' : 'Kuota Penuh'}
                </div>
              </div>

              <h2 class="fgd-card-title">{item.title}</h2>
              <p class="fgd-card-desc">{item.description}</p>

              <div class="fgd-speaker-box">
                <div class="speaker-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                  </svg>
                </div>
                <div class="speaker-info">
                  <span class="label">Narasumber & Pemantik:</span>
                  <span class="name">{item.speaker}</span>
                </div>
              </div>

              <div class="fgd-meta-list">
                <div class="meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <span><strong>Waktu:</strong> {item.date} · {item.time}</span>
                </div>

                <div class="meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  <span><strong>Lokasi:</strong> {item.location}</span>
                </div>
              </div>

              <!-- Quota bar -->
              <div class="quota-container">
                <div class="quota-labels">
                  <span>Keterisian Kuota</span>
                  <span><strong>{item.registeredCount}</strong> / {item.quota} Kursi</span>
                </div>
                <div class="quota-progress-bg">
                  <div class={`quota-progress-bar ${isOpen ? 'green' : 'red'}`} style={`width: ${percentQuota}%`}></div>
                </div>
              </div>

              <div class="fgd-tags">
                {item.tags.map((tag: string) => (
                  <span class="tag-chip">#{tag}</span>
                ))}
              </div>

              <div class="fgd-card-footer">
                {isOpen ? (
                  <button
                    type="button"
                    class="btn-register-fgd"
                    data-id={item.id}
                    data-title={item.title}
                  >
                    <span>Daftar FGD Sekarang</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </button>
                ) : (
                  <button type="button" class="btn-register-fgd disabled" disabled>
                    <span>Kuota Sudah Penuh</span>
                  </button>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Modal Pendaftaran FGD -->
    <div id="fgdModal" class="modal-backdrop hide" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-window panel">
        <button type="button" class="modal-close" id="closeModalBtn" aria-label="Tutup formulir">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>

        <div class="modal-header">
          <span class="eyebrow">Formulir Pendaftaran Partisipan</span>
          <h2 id="modalTitle" class="title" style="font-size: 24px; margin-top: 4px;">Pendaftaran Agenda FGD</h2>
          <div class="selected-agenda-box" id="selectedAgendaDisplay">
            <strong>Agenda:</strong> Memuat agenda terpilih...
          </div>
        </div>

        <div id="formAlert" class="auth-alert hide" role="alert"></div>

        <form id="fgdRegisterForm" class="fgd-form">
          <input type="hidden" id="formAgendaId" name="agenda_id" value="" />
          <input type="hidden" id="formAgendaTitle" name="agenda_title" value="" />

          <div class="field">
            <label for="formFullName">Nama Lengkap & Gelar <span class="req">*</span></label>
            <input
              id="formFullName"
              name="full_name"
              type="text"
              placeholder="Contoh: Budi Santoso, S.T."
              value={defaultName}
              required
            />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="formEmail">Alamat Email Aktif <span class="req">*</span></label>
              <input
                id="formEmail"
                name="email"
                type="email"
                placeholder="nama@email.com"
                value={defaultEmail}
                required
              />
            </div>

            <div class="field">
              <label for="formWhatsapp">Nomor WhatsApp <span class="req">*</span></label>
              <input
                id="formWhatsapp"
                name="whatsapp"
                type="tel"
                placeholder="Contoh: 081234567890"
                required
              />
            </div>
          </div>

          <div class="field">
            <label for="formInstitution">Instansi / Komunitas / Kampus</label>
            <input
              id="formInstitution"
              name="institution"
              type="text"
              placeholder="Contoh: ITS Surabaya / Relawan Mangrove Rungkut / Umum"
            />
          </div>

          <div class="field">
            <label for="formMotivation">Motivasi & Isu yang Ingin Disuarakan</label>
            <textarea
              id="formMotivation"
              name="motivation"
              rows="3"
              placeholder="Tuliskan latar belakang minat atau usulan konkret yang ingin Anda bawa dalam diskusi ini..."
            ></textarea>
          </div>

          <div class="modal-actions">
            <button type="button" class="btn-cancel" id="cancelBtn">Batal</button>
            <button type="submit" class="btn-submit" id="submitRegBtn">
              <span class="btn-text">Kirim Pendaftaran</span>
              <span class="btn-spinner hide">Mendaftarkan...</span>
            </button>
          </div>
        </form>

        <div id="successState" class="success-box hide">
          <div class="success-icon">🎉</div>
          <h3>Pendaftaran Anda Berhasil!</h3>
          <p id="successMsg">
            Terima kasih telah bergabung. Undangan resmi, rincian ruangan/link Zoom, dan lembar materi pengantar akan segera dikirimkan ke email dan nomor WhatsApp Anda.
          </p>
          <button type="button" class="submit" id="closeSuccessBtn" style="margin-top: 18px;">
            Selesai
          </button>
        </div>
      </div>
    </div>
  </main>

  <style>
    .fgd-page {
      padding-bottom: 80px;
    }
    .fgd-hero {
      background: linear-gradient(135deg, #0E3A21 0%, #1B6B3A 55%, #248248 100%);
      color: #FFFFFF;
      padding: 64px 0 54px;
      position: relative;
      overflow: hidden;
    }
    .fgd-hero::after {
      content: '';
      position: absolute;
      bottom: -40px;
      right: -40px;
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(229,88,142,0.18) 0%, rgba(255,255,255,0) 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    .hero-content {
      max-width: 820px;
    }
    .fgd-hero .eyebrow {
      color: var(--g300);
      background: rgba(255, 255, 255, 0.12);
      padding: 6px 14px;
      border-radius: 100px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      background: #8FCBA3;
      border-radius: 50%;
      box-shadow: 0 0 10px #8FCBA3;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.3); opacity: 1; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .fgd-hero-title {
      font-size: 40px;
      color: #FFFFFF;
      margin-top: 14px;
      line-height: 1.18;
    }
    .fgd-hero-intro {
      color: #E2ECE3;
      font-size: 16.5px;
      margin-top: 16px;
      line-height: 1.65;
      max-width: 72ch;
    }
    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 30px;
    }
    .stat-pill {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 14px;
      padding: 10px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      backdrop-filter: blur(4px);
    }
    .stat-pill .num {
      font-family: var(--logo);
      font-size: 22px;
      font-weight: 800;
      color: #FFFFFF;
    }
    .stat-pill .lbl {
      font-size: 13px;
      color: #DDEFE1;
      font-weight: 600;
    }
    .fgd-grid-section {
      margin-top: 48px;
    }
    .fgd-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 28px;
      margin-top: 24px;
    }
    .fgd-card {
      display: flex;
      flex-direction: column;
      padding: 28px;
      border: 1px solid var(--line);
      border-radius: var(--r);
      background: #FFFFFF;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .fgd-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
    }
    .fgd-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }
    .topic-badge {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--g700);
      background: var(--g100);
      padding: 5px 12px;
      border-radius: 100px;
    }
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 100px;
    }
    .status-pill.open {
      background: #DEF7EC;
      color: #03543F;
    }
    .status-pill.full {
      background: #FDE8E8;
      color: #9B1C1C;
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }
    .fgd-card-title {
      font-size: 20px;
      color: var(--g900);
      line-height: 1.3;
      margin-bottom: 10px;
    }
    .fgd-card-desc {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.55;
      margin-bottom: 18px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .fgd-speaker-box {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: var(--g50);
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid var(--line);
      margin-bottom: 16px;
    }
    .speaker-icon {
      color: var(--g700);
      flex: none;
      margin-top: 2px;
    }
    .speaker-info {
      display: flex;
      flex-direction: column;
      font-size: 13px;
    }
    .speaker-info .label {
      font-size: 11.5px;
      color: var(--muted);
      font-weight: 600;
    }
    .speaker-info .name {
      color: var(--text);
      font-weight: 700;
      margin-top: 1px;
    }
    .fgd-meta-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: 13.5px;
      color: var(--text);
      margin-bottom: 18px;
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
    }
    .meta-item svg {
      color: var(--g700);
      flex: none;
    }
    .meta-item strong {
      color: var(--text);
    }
    .quota-container {
      margin-bottom: 16px;
    }
    .quota-labels {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .quota-progress-bg {
      height: 7px;
      background: var(--line);
      border-radius: 10px;
      overflow: hidden;
    }
    .quota-progress-bar {
      height: 100%;
      border-radius: 10px;
      transition: width 0.4s ease;
    }
    .quota-progress-bar.green {
      background: linear-gradient(90deg, var(--g500), var(--g700));
    }
    .quota-progress-bar.red {
      background: #E02424;
    }
    .fgd-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 22px;
    }
    .tag-chip {
      font-size: 11.5px;
      color: var(--muted);
      background: #F3F4F6;
      padding: 3px 8px;
      border-radius: 6px;
      font-weight: 600;
    }
    .fgd-card-footer {
      margin-top: auto;
    }
    .btn-register-fgd {
      width: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--g700);
      color: #FFFFFF;
      font-weight: 700;
      font-size: 14.5px;
      padding: 12px 18px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      transition: background-color 0.15s, transform 0.15s;
    }
    .btn-register-fgd:hover:not(.disabled) {
      background: var(--g900);
      transform: translateY(-1px);
    }
    .btn-register-fgd.disabled {
      background: #E5E7EB;
      color: #9CA3AF;
      cursor: not-allowed;
    }

    /* Modal Backdrop */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(14, 58, 33, 0.65);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-window {
      background: #FFFFFF;
      max-width: 580px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      border-radius: var(--r);
      padding: 36px 32px;
      position: relative;
      box-shadow: 0 20px 50px rgba(0,0,0,0.3);
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes modalIn {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .modal-close {
      position: absolute;
      top: 20px;
      right: 20px;
      background: #F3F4F6;
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      cursor: pointer;
      color: var(--muted);
      transition: background-color 0.15s;
    }
    .modal-close:hover {
      background: #E5E7EB;
      color: var(--text);
    }
    .selected-agenda-box {
      margin-top: 12px;
      padding: 10px 14px;
      background: var(--g50);
      border-left: 4px solid var(--g700);
      border-radius: 8px;
      font-size: 13.5px;
      color: var(--g900);
    }
    .fgd-form {
      margin-top: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .req {
      color: #E02424;
    }
    .modal-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 10px;
    }
    .btn-cancel {
      padding: 12px 20px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: #FFFFFF;
      font-weight: 700;
      color: var(--muted);
      cursor: pointer;
    }
    .btn-cancel:hover {
      background: #F9FAFB;
    }
    .btn-submit {
      padding: 12px 24px;
      border-radius: 12px;
      border: none;
      background: var(--pink);
      color: #FFFFFF;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(229,88,142,0.3);
      transition: background-color 0.15s;
    }
    .btn-submit:hover {
      background: var(--pink700);
    }
    .auth-alert {
      padding: 12px 16px;
      border-radius: var(--r-sm);
      font-size: 13.5px;
      font-weight: 600;
      margin-top: 14px;
    }
    .auth-alert.error {
      background: #FDE8E8;
      border: 1px solid #F8B4B4;
      color: #9B1C1C;
    }
    .auth-alert.success {
      background: #DEF7EC;
      border: 1px solid #BCF0DA;
      color: #03543F;
    }
    .success-box {
      text-align: center;
      padding: 30px 10px;
    }
    .success-icon {
      font-size: 52px;
      margin-bottom: 12px;
    }
    .success-box h3 {
      font-size: 24px;
      color: var(--g700);
      margin-bottom: 8px;
    }
    .success-box p {
      color: var(--muted);
      font-size: 14.5px;
      line-height: 1.6;
    }
    @media (max-width: 640px) {
      .field-row {
        grid-template-columns: 1fr;
      }
      .fgd-cards-grid {
        grid-template-columns: 1fr;
      }
      .fgd-hero-title {
        font-size: 30px;
      }
    }
  </style>

  <script>
    const modal = document.getElementById('fgdModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const cancelBtn = document.getElementById('cancelBtn');
    const agendaDisplay = document.getElementById('selectedAgendaDisplay');
    const formAgendaId = document.getElementById('formAgendaId') as HTMLInputElement | null;
    const formAgendaTitle = document.getElementById('formAgendaTitle') as HTMLInputElement | null;
    const form = document.getElementById('fgdRegisterForm') as HTMLFormElement | null;
    const formAlert = document.getElementById('formAlert');
    const submitRegBtn = document.getElementById('submitRegBtn') as HTMLButtonElement | null;
    const btnText = submitRegBtn?.querySelector('.btn-text');
    const btnSpinner = submitRegBtn?.querySelector('.btn-spinner');
    const successState = document.getElementById('successState');
    const closeSuccessBtn = document.getElementById('closeSuccessBtn');

    function openModal(agendaId: string, agendaTitle: string) {
      if (!modal) return;
      if (formAgendaId) formAgendaId.value = agendaId;
      if (formAgendaTitle) formAgendaTitle.value = agendaTitle;
      if (agendaDisplay) {
        agendaDisplay.innerHTML = `<strong>Agenda Terpilih:</strong> ${agendaTitle}`;
      }
      if (formAlert) {
        formAlert.classList.add('hide');
        formAlert.textContent = '';
      }
      if (form) form.classList.remove('hide');
      if (successState) successState.classList.add('hide');

      modal.classList.remove('hide');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hide');
      document.body.style.overflow = '';
    }

    // Bind open modal on register buttons
    document.querySelectorAll<HTMLButtonElement>('.btn-register-fgd:not(.disabled)').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id || '';
        const title = btn.dataset.title || 'Agenda FGD';
        openModal(id, title);
      });
    });

    closeModalBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);
    closeSuccessBtn?.addEventListener('click', () => {
      closeModal();
      window.location.reload();
    });

    // Close on backdrop click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Handle Form Submit
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const agenda_id = formAgendaId?.value;
        const agenda_title = formAgendaTitle?.value;
        const full_name = (document.getElementById('formFullName') as HTMLInputElement)?.value.trim();
        const email = (document.getElementById('formEmail') as HTMLInputElement)?.value.trim();
        const whatsapp = (document.getElementById('formWhatsapp') as HTMLInputElement)?.value.trim();
        const institution = (document.getElementById('formInstitution') as HTMLInputElement)?.value.trim();
        const motivation = (document.getElementById('formMotivation') as HTMLTextAreaElement)?.value.trim();

        if (!agenda_id || !full_name || !email || !whatsapp) {
          if (formAlert) {
            formAlert.textContent = 'Harap isi semua kolom bertanda bintang (*).';
            formAlert.className = 'auth-alert error';
            formAlert.classList.remove('hide');
          }
          return;
        }

        // Set Loading
        if (submitRegBtn) submitRegBtn.disabled = true;
        btnText?.classList.add('hide');
        btnSpinner?.classList.remove('hide');
        if (formAlert) formAlert.classList.add('hide');

        try {
          const res = await fetch('/api/fgd/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              agenda_id,
              agenda_title,
              full_name,
              email,
              whatsapp,
              institution,
              motivation,
            }),
          });

          const data = await res.json();

          if (!res.ok) {
            if (formAlert) {
              formAlert.textContent = data.error || 'Gagal mengirim pendaftaran.';
              formAlert.className = 'auth-alert error';
              formAlert.classList.remove('hide');
            }
            if (submitRegBtn) submitRegBtn.disabled = false;
            btnText?.classList.remove('hide');
            btnSpinner?.classList.add('hide');
            return;
          }

          // Sukses
          form.classList.add('hide');
          if (successState) successState.classList.remove('hide');
        } catch (err: any) {
          if (formAlert) {
            formAlert.textContent = err?.message || 'Terjadi gangguan koneksi jaringan.';
            formAlert.className = 'auth-alert error';
            formAlert.classList.remove('hide');
          }
          if (submitRegBtn) submitRegBtn.disabled = false;
          btnText?.classList.remove('hide');
          btnSpinner?.classList.add('hide');
        }
      });
    }
  </script>
</Layout>
