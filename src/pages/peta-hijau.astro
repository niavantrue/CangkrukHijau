---
import Layout from '../layouts/Layout.astro';
import ParkCard from '../components/ParkCard.astro';

export const parksData = [
  {
    id: 'bungkul',
    name: 'Taman Bungkul',
    area: 'Surabaya Pusat',
    type: 'Taman Kota Ikonik & Ramah Anak',
    lat: -7.2913,
    lng: 112.7398,
    image: '/images/taman/taman-bungkul.webp',
    address: 'Jl. Taman Bungkul, Darmo, Kec. Wonokromo, Surabaya',
    hours: 'Buka 24 Jam · Area Olahraga, Kuliner & Ramah Anak',
    facilities: ['Jogging Track', 'Skate Park', 'Sentra PKL', 'WiFi Gratis', 'Taman Bermain Anak'],
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=-7.2913,112.7398',
  },
  {
    id: 'flora-bratang',
    name: 'Taman Flora Bratang (Kebun Bibit Bratang)',
    area: 'Surabaya Timur',
    type: 'Kebun Botani & Edukasi Satwa',
    lat: -7.2957,
    lng: 112.7601,
    image: '/images/taman/taman-flora.webp',
    address: 'Jl. Bratang Binangun, Baratajaya, Kec. Gubeng, Surabaya',
    hours: '06:00 - 18:00 WIB · Rindang, Edukasi Rusa & Burung',
    facilities: ['Koleksi Tanaman Langka', 'Kandang Rusa', 'Kolam Ikan', 'Taman Baca Digital', 'Playground'],
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=-7.2957,112.7601',
  },
  {
    id: 'bibit-wonorejo',
    name: 'Kebun Bibit Wonorejo',
    area: 'Surabaya Timur / Rungkut',
    type: 'Ekowisata Danau & Pembibitan Kota',
    lat: -7.3115,
    lng: 112.7847,
    image: '/images/taman/kebun-bibit-wonorejo.webp',
    address: 'Jl. Kendalsari, Wonorejo, Kec. Rungkut, Surabaya',
    hours: '06:00 - 18:00 WIB · Danau Resapan & Pembibitan Pohon',
    facilities: ['Danau Buatan', 'Taman Bunga', 'Wall Climbing', 'Jogging Track', 'Sentra Bibit Gratis'],
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=-7.3115,112.7847',
  },
  {
    id: 'bambu-keputih',
    name: 'Hutan Bambu Keputih',
    area: 'Surabaya Timur',
    type: 'Hutan Bambu Eksotis & Spot Foto Alam',
    lat: -7.2934,
    lng: 112.8021,
    image: '/images/taman/hutan-bambu-keputih.webp',
    address: 'Jl. Raya Marina Asri, Keputih, Kec. Sukolilo, Surabaya',
    hours: '06:00 - 18:00 WIB · Kanopi Bambu Sejuk',
    facilities: ['Spot Foto Populer', 'Jalur Pejalan Kaki Rindang', 'Kawasan Teduh'],
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=-7.2934,112.8021',
  },
  {
    id: 'harmoni-keputih',
    name: 'Taman Harmoni Keputih',
    area: 'Surabaya Timur',
    type: 'Taman Bunga Tematik & Hutan Kota',
    lat: -7.2956,
    lng: 112.8009,
    image: '/images/taman/taman-harmoni.webp',
    address: 'Jl. Keputih Tegal Timur II, Keputih, Kec. Sukolilo, Surabaya',
    hours: '06:00 - 18:00 WIB · Padang Bunga Sakura & Tabebuya',
    facilities: ['Taman Bunga Warna-warni', 'Refleksi Kaki', 'Area Bermain Anak', 'Pusat Daur Ulang Kompos'],
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=-7.2956,112.8009',
  },
  {
    id: 'mangrove-sby',
    name: 'Kebun Raya Mangrove Surabaya (Gunung Anyar & Wonorejo)',
    area: 'Surabaya Timur / Pesisir',
    type: 'Konservasi Mangrove & Suaka Burung Pesisir',
    lat: -7.3072,
    lng: 112.8256,
    image: '/images/taman/kebun-raya-mangrove.webp',
    address: 'Jl. Medokan Sawah Timur, Gunung Anyar Tambak, Surabaya',
    hours: '07:00 - 17:00 WIB · Boardwalk Kayu & Perahu Susur',
    facilities: ['Wooden Boardwalk 1.5 km', 'Menara Pandang Burung', 'Perahu Wisata Susur Sungai', 'Pusat Edukasi Bakau'],
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=-7.3072,112.8256',
  },
  {
    id: 'prestasi',
    name: 'Taman Prestasi Surabaya',
    area: 'Surabaya Pusat / Genteng',
    type: 'Taman Tepi Sungai Kalimas & Wisata Perahu',
    lat: -7.2612,
    lng: 112.7441,
    image: '/images/taman/taman-prestasi.webp',
    address: 'Jl. Ketabang Kali No. 6, Ketabang, Kec. Genteng, Surabaya',
    hours: '08:00 - 21:00 WIB · Dermaga Perahu Kalimas & Rekreasi',
    facilities: ['Dermaga Wisata Perahu', 'Panggung Terbuka', 'Taman Bermain Anak', 'Monumen Pesawat'],
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=-7.2612,112.7441',
  },
  {
    id: 'hutan-pakal',
    name: 'Hutan Kota Pakal',
    area: 'Surabaya Barat',
    type: 'Hutan Lindung & Konservasi Hayati Barat',
    lat: -7.2346,
    lng: 112.6083,
    image: '/images/taman/taman-cahaya.webp',
    address: 'Jl. Raya Pakal, Sidorejo, Kec. Pakal, Surabaya',
    hours: '06:00 - 17:00 WIB · Konservasi Pohon Kayu Keras & Danau',
    facilities: ['Kolam Pemancingan', 'Arboretum Pohon Langka', 'Gazebo Teduh', 'Jalur Sepeda Tanah'],
    mapsUrl: 'https://www.google.com/maps/search/?api=1&query=-7.2346,112.6083',
  },
];
---

<Layout
  title="Peta Interaktif Ruang Terbuka Hijau | Cangkruk Hijau"
  description="Peta interaktif sebaran taman kota, kebun raya mangrove, dan ruang terbuka hijau (RTH) publik di Surabaya berbasis OpenStreetMap dan Leaflet.js."
  activeNav="ruang-hijau"
  lang="id"
>
  <!-- Leaflet CDN Stylesheet -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  <main class="map-page">
    <div class="wrap">
      <div style="margin-bottom: 20px;">
        <a class="back" href="/">← Kembali ke Beranda</a>
      </div>

      <header class="map-header">
        <div class="eyebrow" style="display: inline-flex; align-items: center; gap: 8px;">
          <span class="live-indicator"></span> Peta Interaktif RTH Surabaya
        </div>
        <h1 class="title" style="font-size: 34px; margin-top: 8px;">
          Jelajahi Taman & Paru-Paru Hijau Surabaya
        </h1>
        <p class="intro" style="color: var(--muted); font-size: 15px; margin-top: 8px; max-width: 68ch;">
          Temukan ruang terbuka hijau terdekat untuk berolahraga, bersantai bersama keluarga, observasi keanekaragaman hayati, atau sekadar berteduh di bawah kanopi pohon kota.
        </p>
      </header>

      <!-- Map & Sidebar Grid -->
      <div class="map-layout-grid" style="margin-top: 24px;">
        <!-- Leaflet Map Container -->
        <div class="map-card-wrapper panel">
          <div class="map-toolbar">
            <span class="map-status">📍 {parksData.length} Titik Taman RTH Terdata</span>
            <div class="map-tips">Klik pin marker untuk melihat rincian taman & rute GPS</div>
          </div>
          <div id="leafletMap" class="leaflet-container-custom"></div>
        </div>

        <!-- Sidebar List Taman -->
        <div class="parks-sidebar-wrap">
          <div class="parks-sidebar-header">
            <h3>Daftar Taman Kota</h3>
            <span class="badge visi">Surabaya</span>
          </div>

          <div class="parks-scroll-list" id="parksList">
            {parksData.map((park) => (
              <article
                class="park-item-card"
                data-id={park.id}
                data-lat={park.lat}
                data-lng={park.lng}
                data-name={park.name}
              >
                <div class="park-item-img">
                  <img src={park.image} alt={park.name} loading="lazy" />
                </div>
                <div class="park-item-info">
                  <span class="park-area-badge">{park.area}</span>
                  <h4 class="park-name">{park.name}</h4>
                  <p class="park-hours">{park.hours}</p>
                  <div class="park-actions">
                    <button type="button" class="btn-focus-map">
                      🎯 Lihat di Peta
                    </button>
                    <a
                      href={park.mapsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-gmaps"
                    >
                      🗺️ Google Maps
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>

  <style>
    .map-page {
      padding: 36px 0 80px;
    }
    .live-indicator {
      width: 8px;
      height: 8px;
      background: #3E9B5F;
      border-radius: 50%;
      box-shadow: 0 0 8px #3E9B5F;
      animation: pulseGreen 2s infinite;
    }
    @keyframes pulseGreen {
      0% { transform: scale(0.9); opacity: 0.7; }
      50% { transform: scale(1.3); opacity: 1; }
      100% { transform: scale(0.9); opacity: 0.7; }
    }
    .map-layout-grid {
      display: grid;
      grid-template-columns: 1.3fr 0.9fr;
      gap: 24px;
      align-items: start;
    }
    .map-card-wrapper {
      padding: 16px;
      border-radius: var(--r);
      background: #FFFFFF;
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .map-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
      padding: 0 6px;
      flex-wrap: wrap;
    }
    .map-status {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--g700);
    }
    .map-tips {
      font-size: 12px;
      color: var(--muted);
    }
    .leaflet-container-custom {
      width: 100%;
      height: 580px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--line);
      z-index: 1;
    }

    /* Sidebar list */
    .parks-sidebar-wrap {
      background: #FFFFFF;
      border: 1px solid var(--line);
      border-radius: var(--r);
      padding: 20px;
      box-shadow: var(--shadow);
      max-height: 640px;
      display: flex;
      flex-direction: column;
    }
    .parks-sidebar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--line);
      margin-bottom: 14px;
    }
    .parks-sidebar-header h3 {
      font-size: 18px;
      color: var(--g900);
    }
    .parks-scroll-list {
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding-right: 4px;
    }
    .park-item-card {
      display: grid;
      grid-template-columns: 84px 1fr;
      gap: 14px;
      padding: 12px;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: #FAFCFA;
      transition: all 0.15s ease;
      cursor: pointer;
    }
    .park-item-card:hover, .park-item-card.is-active {
      border-color: var(--g700);
      background: #F0F7F2;
      transform: translateY(-2px);
    }
    .park-item-img {
      border-radius: 10px;
      overflow: hidden;
      height: 84px;
      background: #E5E7EB;
    }
    .park-item-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .park-item-info {
      display: flex;
      flex-direction: column;
    }
    .park-area-badge {
      font-size: 11px;
      font-weight: 700;
      color: var(--g700);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .park-name {
      font-size: 15px;
      color: var(--g900);
      margin-top: 2px;
      line-height: 1.25;
    }
    .park-hours {
      font-size: 12px;
      color: var(--muted);
      margin-top: 4px;
      line-height: 1.35;
    }
    .park-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 8px;
    }
    .btn-focus-map {
      background: var(--g700);
      color: #FFFFFF;
      border: none;
      border-radius: 6px;
      padding: 4px 8px;
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
    }
    .btn-focus-map:hover {
      background: var(--g900);
    }
    .btn-gmaps {
      color: var(--g700);
      font-size: 11.5px;
      font-weight: 700;
      text-decoration: underline;
    }

    /* Popup leaflet styles */
    :global(.leaflet-popup-content-wrapper) {
      border-radius: 16px;
      padding: 4px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    :global(.popup-park-box) {
      font-family: var(--sans);
      max-width: 250px;
    }
    :global(.popup-park-img) {
      width: 100%;
      height: 110px;
      object-fit: cover;
      border-radius: 10px;
      margin-bottom: 8px;
    }
    :global(.popup-park-title) {
      font-size: 15px;
      font-weight: 800;
      color: #0E3A21;
      margin-bottom: 4px;
    }
    :global(.popup-park-desc) {
      font-size: 12px;
      color: #4B5563;
      line-height: 1.4;
      margin-bottom: 8px;
    }
    :global(.popup-park-link) {
      display: inline-block;
      background: #1B6B3A;
      color: #FFFFFF !important;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 700;
      text-decoration: none;
    }

    @media (max-width: 900px) {
      .map-layout-grid {
        grid-template-columns: 1fr;
      }
      .leaflet-container-custom {
        height: 400px;
      }
    }
  </style>

  <!-- Leaflet CDN JS -->
  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>

  <script define:vars={{ parks: parksData }}>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof L === 'undefined') return;

      // Inisialisasi peta berpusat di Surabaya
      const map = L.map('leafletMap', {
        center: [-7.285, 112.755],
        zoom: 12,
        scrollWheelZoom: false,
      });

      // Tambahkan tile layer OpenStreetMap
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 18,
      }).addTo(map);

      // Custom Green Icon
      const greenIcon = L.divIcon({
        className: 'custom-leaflet-marker',
        html: `<div style="
          background: #1B6B3A;
          color: white;
          width: 32px;
          height: 32px;
          border-radius: 50% 50% 50% 0;
          transform: rotate(-45deg);
          display: grid;
          place-items: center;
          border: 2px solid white;
          box-shadow: 0 3px 8px rgba(0,0,0,0.35);
        ">
          <span style="transform: rotate(45deg); font-size: 14px;">🌳</span>
        </div>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -32],
      });

      const markersMap = {};

      // Tambahkan Marker untuk setiap taman
      parks.forEach((park) => {
        const popupContent = `
          <div class="popup-park-box">
            <img src="${park.image}" alt="${park.name}" class="popup-park-img" />
            <div class="popup-park-title">${park.name}</div>
            <div class="popup-park-desc">${park.hours}</div>
            <a href="${park.mapsUrl}" target="_blank" rel="noopener noreferrer" class="popup-park-link">
              Rute Google Maps →
            </a>
          </div>
        `;

        const marker = L.marker([park.lat, park.lng], { icon: greenIcon })
          .addTo(map)
          .bindPopup(popupContent);

        markersMap[park.id] = marker;
      });

      // Bind klik pada item kartu sidebar
      document.querySelectorAll('.park-item-card').forEach((card) => {
        card.addEventListener('click', (e) => {
          // Cegah jika klik link gmaps langsung
          if (e.target.tagName.toLowerCase() === 'a') return;

          const parkId = card.getAttribute('data-id');
          const lat = parseFloat(card.getAttribute('data-lat'));
          const lng = parseFloat(card.getAttribute('data-lng'));

          document.querySelectorAll('.park-item-card').forEach((c) => c.classList.remove('is-active'));
          card.classList.add('is-active');

          map.flyTo([lat, lng], 15, { duration: 1.2 });

          const marker = markersMap[parkId];
          if (marker) {
            setTimeout(() => {
              marker.openPopup();
            }, 600);
          }
        });
      });
    });
  </script>
</Layout>
