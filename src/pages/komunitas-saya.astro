---
import Layout from '../layouts/Layout.astro';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

if (!user) {
  return Astro.redirect('/login?redirect=/komunitas-saya');
}

let joinedList: Array<{
  id: string | number;
  community_id: string;
  community_name: string;
  joined_at: string;
}> = [];

if (supabase) {
  try {
    const { data, error } = await supabase
      .from('user_communities')
      .select('*')
      .eq('user_id', user.id)
      .order('joined_at', { ascending: false });

    if (data) {
      joinedList = data;
    }
  } catch (err) {
    // Graceful fallback
  }
}

const userName = user.user_metadata?.full_name || user.email?.split('@')[0] || 'Relawan Hijau';
---

<Layout
  title="Komunitas Saya | Cangkruk Hijau"
  description="Dashboard Komunitas Saya: Kelola komunitas lingkungan yang Anda ikuti di Cangkruk Hijau Surabaya."
  activeNav="komunitas-saya"
  lang="id"
>
  <main class="dashboard-page">
    <div class="wrap">
      <div style="margin-bottom: 24px;">
        <a class="back" href="/komunitas">← Kembali ke Daftar Komunitas</a>
      </div>

      <!-- Header Dashboard -->
      <div class="dashboard-header panel">
        <div class="dash-profile">
          <div class="dash-avatar">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a5 5 0 1 0 5 5 5 5 0 0 0-5-5Zm0 12c-5.33 0-8 2.67-8 4v2h16v-2c0-1.33-2.67-4-8-4Z"/>
            </svg>
          </div>
          <div>
            <div class="eyebrow">Dashboard Relawan</div>
            <h1 class="title" style="font-size: 28px; margin-top: 4px;">Halo, {userName}!</h1>
            <p style="color: var(--muted); font-size: 14px; margin-top: 4px;">
              Email: <strong>{user.email}</strong> · Bergabung di <strong>{joinedList.length}</strong> komunitas
            </p>
          </div>
        </div>

        <a href="/komunitas" class="cta" style="margin-top: 0; padding: 12px 22px; font-size: 14.5px;">
          + Cari Komunitas Lain
        </a>
      </div>

      <!-- Toast Feedback -->
      <div id="toastNotification" class="toast-notice hide"></div>

      <!-- Section Title -->
      <div class="shead" style="margin-top: 36px;">
        <div class="stitle">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="8" cy="8" r="3.4" fill="#3E9B5F"/>
            <circle cx="16.5" cy="9.5" r="2.8" fill="#8FCBA3"/>
            <path d="M2 20c0-3.4 2.7-5.6 6-5.6s6 2.2 6 5.6Z" fill="#3E9B5F"/>
            <path d="M14.6 20c0-2.6 1.6-4.4 4-4.4 2.2 0 3.4 1.6 3.4 4.4Z" fill="#8FCBA3"/>
          </svg>
          Komunitas yang Anda Ikuti
        </div>
        <span class="count">{joinedList.length} Komunitas Aktif</span>
      </div>

      <!-- Content List -->
      {joinedList.length === 0 ? (
        <div class="empty-state panel">
          <div class="empty-icon">🌱</div>
          <h2>Belum ada komunitas yang diikuti</h2>
          <p>
            Anda belum bergabung dengan komunitas lingkungan mana pun. Temukan komunitas peduli sampah, mangrove, atau advokasi lingkungan di Surabaya dan mulailah beraksi!
          </p>
          <a href="/komunitas" class="submit" style="margin-top: 20px;">
            Jelajahi Komunitas Sekarang
          </a>
        </div>
      ) : (
        <div class="grid3" id="myCommunitiesGrid">
          {joinedList.map((item) => {
            const joinedDate = item.joined_at
              ? new Date(item.joined_at).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                })
              : 'Baru saja';

            return (
              <article class="card my-community-card" data-id={item.community_id} data-record-id={item.id}>
                <div class="card-top">
                  <span class="chip" style="background: #DDEFE1; color: var(--g700);">Anggota Aktif</span>
                  <span class="badge visi" style="margin-left: auto; background: var(--g500);">Terdaftar</span>
                </div>

                <h3 style="margin-top: 14px; font-size: 20px; color: var(--g700);">{item.community_name}</h3>
                
                <div class="meta" style="margin-top: 12px; font-size: 13.5px;">
                  <div><strong>ID Komunitas:</strong> {item.community_id}</div>
                  <div style="margin-top: 4px;"><strong>Tanggal Bergabung:</strong> {joinedDate}</div>
                </div>

                <div class="actions" style="margin-top: 20px; justify-content: space-between; align-items: center;">
                  <a
                    href="https://wa.me/6288127371159?text=Halo%2C%20saya%20anggota%20komunitas%20Cangkruk%20Hijau."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn"
                    style="font-size: 13px;"
                  >
                    Kontak Grup
                  </a>

                  <button
                    type="button"
                    class="btn btn-leave"
                    data-community-id={item.community_id}
                    data-community-name={item.community_name}
                    data-id={item.id}
                  >
                    Batal Gabung
                  </button>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <style>
    .dashboard-page {
      padding: 42px 0 72px;
    }
    .dashboard-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      background: linear-gradient(135deg, #edf6ea 0%, #ffffff 100%);
      border: 1px solid var(--line);
    }
    .dash-profile {
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .dash-avatar {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--g700);
      color: #fff;
      display: grid;
      place-items: center;
      flex: none;
      box-shadow: var(--shadow);
    }
    .empty-state {
      text-align: center;
      padding: 60px 32px;
      max-width: 640px;
      margin: 20px auto 0;
      border: 1px dashed var(--g300);
    }
    .empty-icon {
      font-size: 48px;
      margin-bottom: 12px;
    }
    .empty-state h2 {
      font-size: 24px;
      color: var(--g700);
      margin-bottom: 10px;
    }
    .empty-state p {
      color: var(--muted);
      font-size: 15px;
      max-width: 48ch;
      margin: 0 auto;
    }
    .my-community-card {
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      display: flex;
      flex-direction: column;
    }
    .btn-leave {
      background: #fde8e8;
      border: 1px solid #f8b4b4;
      color: #9b1c1c;
      font-size: 13px;
      font-weight: 700;
      padding: 8px 14px;
      border-radius: 10px;
      cursor: pointer;
      transition: background-color 0.15s;
    }
    .btn-leave:hover {
      background: #f8b4b4;
    }
    .toast-notice {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 1000;
      padding: 14px 20px;
      border-radius: 12px;
      background: var(--g900);
      color: #fff;
      font-weight: 600;
      font-size: 14px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    }
    @media (max-width: 760px) {
      .dashboard-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .dash-profile {
        width: 100%;
      }
    }
  </style>

  <script>
    const toast = document.getElementById('toastNotification');

    function showToast(message: string, isError = false) {
      if (!toast) return;
      toast.textContent = message;
      toast.style.background = isError ? '#9B1C1C' : '#0E3A21';
      toast.classList.remove('hide');
      setTimeout(() => {
        toast.classList.add('hide');
      }, 3500);
    }

    document.querySelectorAll<HTMLButtonElement>('.my-community-card .btn-leave').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const communityId = btn.dataset.communityId;
        const communityName = btn.dataset.communityName || 'Komunitas';
        const card = btn.closest('.my-community-card');

        if (!confirm(`Apakah Anda yakin ingin membatalkan keanggotaan di ${communityName}?`)) {
          return;
        }

        btn.disabled = true;

        try {
          const res = await fetch('/api/communities/leave', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              community_id: communityId,
            }),
          });
          const data = await res.json();

          if (!res.ok) {
            showToast(data.error || 'Gagal membatalkan keanggotaan.', true);
            btn.disabled = false;
            return;
          }

          showToast(`Berhasil keluar dari ${communityName}.`);
          if (card) {
            card.remove();
          }

          // Check if list is empty now
          const remainingCards = document.querySelectorAll('.my-community-card');
          if (remainingCards.length === 0) {
            window.location.reload();
          }
        } catch (err) {
          showToast('Terjadi kesalahan jaringan.', true);
          btn.disabled = false;
        }
      });
    });
  </script>
</Layout>
