---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getArticleBySlug, getRelatedArticles } from '../../data/berita.js';

const { slug } = Astro.params;
const article = getArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/berita', 302);
}

const relatedArticles = getRelatedArticles(article.slug, 3);
const pillColorClass = article.categoryColor.startsWith('p-') ? article.categoryColor : `p-${article.categoryColor}`;
---

<Layout
  title={`${article.title} | Cangkruk Hijau`}
  description={article.summary}
  activeNav="berita"
  lang="id"
>
  <main class="article-page">
    <div class="wrap article-wrap">
      <!-- Breadcrumb / Back Navigation -->
      <div class="article-top-nav">
        <a class="back" href="/berita">← Kembali ke Semua Berita</a>
      </div>

      <!-- Article Header -->
      <header class="article-header">
        <div class="article-meta-top">
          <span class={`pill ${pillColorClass}`}>{article.category}</span>
          <span class="read-time">⏱ {article.readTime}</span>
        </div>

        <h1 class="article-title">{article.title}</h1>

        <div class="article-byline">
          <div class="author-avatar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a5 5 0 1 0 5 5 5 5 0 0 0-5-5Zm0 12c-5.33 0-8 2.67-8 4v2h16v-2c0-1.33-2.67-4-8-4Z"/>
            </svg>
          </div>
          <div class="byline-info">
            <span class="author-name">{article.author}</span>
            <span class="pub-date">Dipublikasikan pada {article.date} · Surabaya</span>
          </div>
        </div>
      </header>

      <!-- Featured Banner / Cover Image -->
      <div class="article-hero-art">
        {article.coverImage ? (
          <img
            src={article.coverImage}
            alt={article.title}
            loading="eager"
            class="article-cover-img"
            onerror="this.style.display='none'"
          />
        ) : (
          article.category.toLowerCase().includes('sampah') && (
            <svg viewBox="0 0 800 360" preserveAspectRatio="none" role="img" aria-label="Ilustrasi pemilahan sampah">
              <rect width="800" height="360" fill="#DDEFE1"/>
              <path d="M0 240c160-32 300 28 460 8s240-48 340-24v136H0Z" fill="#3E9B5F"/>
              <rect x="260" y="120" width="90" height="110" rx="14" fill="#4FAE6F"/>
              <rect x="380" y="140" width="80" height="90" rx="12" fill="#2F8A50"/>
              <circle cx="580" cy="110" r="48" fill="#E5588E" opacity=".45"/>
            </svg>
          )
        )}
        <div class="hero-art-caption">Dokumentasi Liputan & Aksi Kolaborasi Cangkruk Hijau Surabaya</div>
      </div>

      <!-- Article Body -->
      <article class="article-content">
        <!-- Lead summary callout -->
        <div class="lead-summary">
          <p>{article.summary}</p>
        </div>

        <!-- Body Paragraphs -->
        <div class="article-narrative">
          {article.content.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <!-- Key Takeaways Box -->
        {article.keyPoints && (
          <div class="key-points-card panel">
            <h3>📌 Poin Utama Berita</h3>
            <ul>
              {article.keyPoints.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        )}

        <!-- Share & Interaction Bar -->
        <div class="article-share-bar">
          <span class="share-label">Bagikan kabar baik ini:</span>
          <div class="share-buttons">
            <a
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' - Baca di Cangkruk Hijau: ' + Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-share wa"
            >
              WhatsApp
            </a>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-share x"
            >
              X / Twitter
            </a>
            <button type="button" class="btn-share copy" id="btnCopyLink">
              Salin Tautan
            </button>
          </div>
        </div>
      </article>

      <!-- Related News Section -->
      <section class="related-section">
        <div class="shead">
          <div class="stitle">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2.5" fill="#3E9B5F"/>
              <rect x="6" y="8" width="7" height="5" rx="1" fill="#DDEFE1"/>
              <rect x="15" y="8" width="4" height="1.6" rx=".8" fill="#DDEFE1"/>
              <rect x="15" y="11.4" width="4" height="1.6" rx=".8" fill="#DDEFE1"/>
              <rect x="6" y="15" width="13" height="1.6" rx=".8" fill="#DDEFE1"/>
            </svg>
            Berita Terkait Lainnya
          </div>
          <a class="slink" href="/berita">Semua Berita →</a>
        </div>

        <div class="grid3">
          {relatedArticles.map((rel) => (
            <NewsCard
              title={rel.title}
              category={rel.category}
              categoryColor={rel.categoryColor}
              date={rel.date}
              coverImage={rel.coverImage}
              href={`/berita/${rel.slug}`}
              asLink={true}
            />
          ))}
        </div>
      </section>
    </div>
  </main>

  <style>
    .article-page {
      padding: 44px 0 80px;
    }
    .article-wrap {
      max-width: 860px;
      margin: 0 auto;
      padding: 0 22px;
    }
    .article-top-nav {
      margin-bottom: 24px;
    }
    .article-header {
      margin-bottom: 28px;
    }
    .article-meta-top {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }
    .article-meta-top .pill {
      position: static;
    }
    .read-time {
      font-size: 13px;
      font-weight: 700;
      color: var(--muted);
    }
    .article-title {
      font-size: clamp(28px, 4.2vw, 44px);
      line-height: 1.18;
      color: var(--g700);
      letter-spacing: -0.02em;
    }
    .article-byline {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
    }
    .author-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--g100);
      color: var(--g700);
      display: grid;
      place-items: center;
      flex: none;
    }
    .byline-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .author-name {
      font-weight: 800;
      font-size: 14.5px;
      color: var(--text);
    }
    .pub-date {
      font-size: 12.5px;
      color: var(--muted);
    }
    .article-hero-art {
      border-radius: var(--r);
      overflow: hidden;
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      background: #fff;
      margin-bottom: 34px;
    }
    .article-hero-art svg,
    .article-cover-img {
      width: 100%;
      height: 380px;
      object-fit: cover;
      display: block;
      background: var(--g50, #eaf5ec);
    }
    .hero-art-caption {
      padding: 10px 18px;
      font-size: 12.5px;
      color: var(--muted);
      background: #fafcfa;
      border-top: 1px solid var(--line);
      text-align: center;
    }
    .lead-summary {
      background: #f0f7f0;
      border-left: 4px solid var(--g500);
      padding: 20px 24px;
      border-radius: 0 var(--r-sm) var(--r-sm) 0;
      margin-bottom: 30px;
    }
    .lead-summary p {
      font-size: 17.5px;
      line-height: 1.6;
      font-weight: 600;
      color: var(--g900);
    }
    .article-narrative {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .article-narrative p {
      font-size: 16.5px;
      line-height: 1.8;
      color: #2b3931;
    }
    .key-points-card {
      margin-top: 36px;
      padding: 26px;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
    }
    .key-points-card h3 {
      font-size: 18px;
      color: var(--g700);
      margin-bottom: 14px;
    }
    .key-points-card ul {
      margin-left: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: 15px;
      color: var(--text);
    }
    .article-share-bar {
      margin-top: 36px;
      padding: 20px 0;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .share-label {
      font-weight: 700;
      font-size: 14px;
      color: var(--muted);
    }
    .share-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn-share {
      padding: 8px 16px;
      border-radius: 100px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--text);
      transition: all 0.15s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }
    .btn-share.wa:hover {
      background: #25d366;
      color: #fff;
      border-color: #25d366;
    }
    .btn-share.x:hover {
      background: #000;
      color: #fff;
      border-color: #000;
    }
    .btn-share.copy:hover {
      background: var(--g700);
      color: #fff;
      border-color: var(--g700);
    }
    .related-section {
      margin-top: 54px;
      padding-top: 36px;
      border-top: 2px dashed var(--line);
    }
  </style>

  <script>
    const btnCopy = document.getElementById('btnCopyLink');
    if (btnCopy) {
      btnCopy.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          const orig = btnCopy.textContent;
          btnCopy.textContent = '✓ Tersalin!';
          setTimeout(() => {
            btnCopy.textContent = orig;
          }, 2000);
        });
      });
    }
  </script>
</Layout>
