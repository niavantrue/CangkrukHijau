---
import Layout from '../layouts/Layout.astro';
import EducationCard from '../components/EducationCard.astro';
import { educationMaterials } from '../data/edukasi.js';

export const prerender = false;

const allTopics = ['Semua', ...Array.from(new Set(educationMaterials.map(m => m.topic)))];
---

<Layout
  title="Ruang Edukasi Lingkungan | Cangkruk Hijau"
  description="Koleksi modul panduan praktis, buku saku, dan kajian riset lingkungan hidup Surabaya yang dapat diunduh gratis dalam format PDF."
  activeNav="edukasi"
  lang="id"
>
  <main class="edu-page">
    <div class="wrap">
      <div class="breadcrumb-bar">
        <a class="back-link" href="/">← Kembali ke Beranda</a>
      </div>

      <header class="edu-header">
        <span class="eyebrow">Pustaka Aksi & Pengetahuan Hijau</span>
        <h1 class="page-title">Ruang Edukasi & Modul Terbuka</h1>
        <p class="intro-desc">
          Pelajari langkah nyata menjaga kelestarian bumi kota Surabaya melalui panduan praktis, buku saku warga, dan ringkasan kajian ilmiah yang dapat diunduh dan dipelajari secara cuma-cuma.
        </p>
      </header>

      <!-- Topic Filter Tabs & Search Bar -->
      <section class="edu-control-panel">
        <div class="topic-tabs" id="topicTabs" role="tablist">
          {allTopics.map((topic, idx) => (
            <button
              class={`topic-tab ${idx === 0 ? 'active' : ''}`}
              data-topic={topic.toLowerCase()}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              {topic}
            </button>
          ))}
        </div>

        <div class="search-wrap">
          <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            class="edu-search-input"
            id="eduSearch"
            type="search"
            placeholder="Cari modul, topik, atau kata kunci..."
            aria-label="Cari materi edukasi"
          />
        </div>
      </section>

      <!-- Education Materials Grid -->
      <section class="edu-grid-section">
        <div class="edu-status-row">
          <span class="results-count" id="resultsCount">
            Menampilkan <strong>{educationMaterials.length}</strong> modul & materi edukasi
          </span>
        </div>

        <div class="edu-cards-grid" id="educationGrid">
          {educationMaterials.map((material) => (
            <div class="edu-card-item" data-topic={material.topic.toLowerCase()} data-title={material.title.toLowerCase()} data-desc={material.description.toLowerCase()}>
              <EducationCard
                id={material.id}
                title={material.title}
                topic={material.topic}
                type={material.type}
                fileSize={material.fileSize}
                pagesCount={material.pagesCount}
                description={material.description}
                highlights={material.highlights}
                icon={material.icon}
                coverImage={material.coverImage}
                pdfUrl={material.pdfUrl}
                downloadName={material.downloadName}
              />
            </div>
          ))}
        </div>

        <div class="edu-empty hide" id="eduEmpty">
          <div class="empty-icon">🍃</div>
          <h3>Materi Tidak Ditemukan</h3>
          <p>Coba gunakan kata kunci pencarian lain atau pilih tab kategori topik yang berbeda.</p>
          <button class="btn btn-reset" id="btnResetSearch">Reset Pencarian</button>
        </div>
      </section>

      <!-- Educational Contribution Banner -->
      <section class="edu-contribute-box">
        <div class="contribute-content">
          <div class="contribute-tag">Punya Kajian atau Modul Lingkungan?</div>
          <h2>Berkontribusi Menyusun Panduan Terbuka</h2>
          <p>
            Cangkruk Hijau membuka ruang kolaborasi bagi akademisi, mahasiswa, peneliti, dan pegiat lingkungan Surabaya untuk mempublikasikan modul serta ringkasan riset lingkungan secara terbuka.
          </p>
        </div>
        <div class="contribute-action">
          <a class="btn primary btn-submit-doc" href="https://wa.me/6281234567890?text=Halo%20Tim%20Cangkruk%20Hijau,%20saya%20ingin%20mengirimkan%20draft%20kajian/modul%20edukasi" target="_blank" rel="noopener noreferrer">
            Kirim Draft Materi →
          </a>
        </div>
      </section>
    </div>
  </main>

  <style>
    .edu-page {
      padding: 48px 0 80px;
    }

    .breadcrumb-bar {
      margin-bottom: 24px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--g700, #1b6b3a);
      font-weight: 700;
      font-size: 0.95rem;
      transition: color 0.15s ease, transform 0.15s ease;
    }

    .back-link:hover {
      color: var(--pink, #e5588e);
      transform: translateX(-3px);
    }

    .edu-header {
      max-width: 820px;
      margin-bottom: 36px;
    }

    .eyebrow {
      display: inline-block;
      color: var(--pink, #e5588e);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .page-title {
      color: var(--g900, #133a22);
      font-family: var(--logo, "Baloo 2", sans-serif);
      font-size: clamp(2rem, 4vw, 3.1rem);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }

    .intro-desc {
      color: var(--muted, #6c7e71);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .edu-control-panel {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 28px;
      background: #ffffff;
      padding: 16px 20px;
      border: 1px solid var(--line, #e2ece3);
      border-radius: var(--r-md, 16px);
      box-shadow: 0 4px 16px rgba(18, 60, 34, 0.04);
    }

    @media (min-width: 860px) {
      .edu-control-panel {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }

    .topic-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: thin;
    }

    .topic-tab {
      background: transparent;
      border: 1px solid #e0ebe2;
      color: #4a5d51;
      padding: 8px 16px;
      border-radius: 100px;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
      font-family: inherit;
    }

    .topic-tab:hover {
      background: var(--g50, #eaf5ec);
      color: var(--g900, #133a22);
      border-color: #bfe0c7;
    }

    .topic-tab.active {
      background: var(--g700, #1b6b3a);
      color: #ffffff;
      border-color: var(--g700, #1b6b3a);
      box-shadow: 0 3px 8px rgba(27, 107, 58, 0.25);
    }

    .search-wrap {
      position: relative;
      min-width: 280px;
    }

    .search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #7a8e7f;
      pointer-events: none;
    }

    .edu-search-input {
      width: 100%;
      padding: 10px 16px 10px 42px;
      border: 1px solid #d5e4d8;
      border-radius: 100px;
      background: #fbfdfa;
      color: #24342b;
      font-size: 0.9rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    }

    .edu-search-input:focus {
      border-color: var(--g700, #1b6b3a);
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(27, 107, 58, 0.12);
    }

    .edu-status-row {
      margin-bottom: 20px;
      font-size: 0.9rem;
      color: var(--muted, #6c7e71);
    }

    .results-count strong {
      color: var(--g900, #133a22);
    }

    .edu-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    @media (max-width: 980px) {
      .edu-cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      .edu-cards-grid {
        grid-template-columns: 1fr;
      }
    }

    .edu-empty {
      padding: 50px 24px;
      background: #ffffff;
      border: 2px dashed #d5e4d8;
      border-radius: var(--r-md, 16px);
      text-align: center;
      color: #55675c;
      margin-top: 10px;
    }

    .edu-empty.hide {
      display: none;
    }

    .empty-icon {
      font-size: 40px;
      margin-bottom: 12px;
    }

    .edu-empty h3 {
      font-size: 1.25rem;
      color: var(--g900, #133a22);
      margin-bottom: 6px;
    }

    .edu-empty p {
      font-size: 0.92rem;
      color: var(--muted, #6c7e71);
      max-width: 420px;
      margin: 0 auto 18px;
    }

    .btn-reset {
      background: var(--g50, #eaf5ec);
      color: var(--g700, #1b6b3a);
      border: 1px solid #c2e2c9;
      padding: 8px 18px;
      border-radius: 100px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s ease;
    }

    .btn-reset:hover {
      background: var(--g700, #1b6b3a);
      color: #ffffff;
    }

    /* Contribute Banner */
    .edu-contribute-box {
      margin-top: 56px;
      background: linear-gradient(135deg, #133a22 0%, #1b6b3a 100%);
      color: #ffffff;
      border-radius: var(--r-lg, 20px);
      padding: 38px 40px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      box-shadow: 0 16px 36px rgba(19, 58, 34, 0.15);
    }

    @media (min-width: 860px) {
      .edu-contribute-box {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
      .contribute-content {
        max-width: 620px;
      }
    }

    .contribute-tag {
      font-size: 0.82rem;
      font-weight: 800;
      color: #8edba3;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }

    .edu-contribute-box h2 {
      font-family: var(--logo, "Baloo 2", sans-serif);
      font-size: 1.8rem;
      font-weight: 800;
      line-height: 1.25;
      margin-bottom: 10px;
      color: #ffffff;
    }

    .edu-contribute-box p {
      font-size: 0.95rem;
      line-height: 1.6;
      color: #d1ead7;
    }

    .btn-submit-doc {
      background: var(--pink, #e5588e);
      color: #ffffff !important;
      padding: 12px 24px;
      font-weight: 800;
      border-radius: 100px;
      white-space: nowrap;
      transition: background 0.15s ease, transform 0.15s ease;
      display: inline-block;
    }

    .btn-submit-doc:hover {
      background: #d6477d;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(229, 88, 142, 0.35);
    }
  </style>

  <script>
    const searchInput = document.getElementById('eduSearch') as HTMLInputElement | null;
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.topic-tab');
    const cardItems = document.querySelectorAll<HTMLElement>('.edu-card-item');
    const emptyState = document.getElementById('eduEmpty');
    const countDisplay = document.getElementById('resultsCount');
    const resetBtn = document.getElementById('btnResetSearch');

    let currentTopic = 'semua';
    let searchQuery = '';

    function applyFilter() {
      let visibleCount = 0;

      cardItems.forEach((item) => {
        const itemTopic = item.getAttribute('data-topic') || '';
        const itemTitle = item.getAttribute('data-title') || '';
        const itemDesc = item.getAttribute('data-desc') || '';

        const matchesTopic = currentTopic === 'semua' || itemTopic === currentTopic;
        const matchesSearch = !searchQuery ||
          itemTitle.includes(searchQuery) ||
          itemDesc.includes(searchQuery) ||
          itemTopic.includes(searchQuery);

        if (matchesTopic && matchesSearch) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hide');
        } else {
          emptyState.classList.add('hide');
        }
      }

      if (countDisplay) {
        countDisplay.innerHTML = `Menampilkan <strong>${visibleCount}</strong> modul & materi edukasi`;
      }
    }

    tabButtons.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabButtons.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        currentTopic = tab.getAttribute('data-topic') || 'semua';
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.toLowerCase().trim();
        applyFilter();
      });

      // Check URL query param ?q=
      const urlParams = new URLSearchParams(window.location.search);
      const initialQuery = urlParams.get('q');
      if (initialQuery) {
        searchInput.value = initialQuery;
        searchQuery = initialQuery.toLowerCase().trim();
        applyFilter();
      }
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        currentTopic = 'semua';
        tabButtons.forEach((t, i) => {
          t.classList.toggle('active', i === 0);
          t.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        });
        applyFilter();
      });
    }
  </script>
</Layout>
