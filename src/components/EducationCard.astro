---
interface Props {
  id?: string;
  title: string;
  topic?: string;
  type?: string;
  fileSize?: string;
  pagesCount?: number;
  description: string;
  highlights?: string[];
  icon?: string;
  coverImage?: string;
  pdfUrl?: string;
  downloadName?: string;
  source?: string;
  badge?: string;
  variant?: 'card' | 'journal';
  href?: string;
}

const {
  id,
  title,
  topic = 'Edukasi Lingkungan',
  type = 'Modul Panduan',
  fileSize = '1.5 MB',
  pagesCount = 12,
  description,
  highlights = [],
  icon = '🌱',
  coverImage,
  pdfUrl = '/documents/panduan-kompos-rumah-tangga.pdf',
  downloadName,
  source,
  badge = 'Modul Edukasi',
  variant = 'card',
  href = '#',
} = Astro.props;

const effectiveDownloadName = downloadName || (pdfUrl ? pdfUrl.split('/').pop() : 'dokumen-edukasi.pdf');
const encodedPdfUrl = pdfUrl ? encodeURI(pdfUrl) : '';
---

{variant === 'journal' ? (
  <a class="ncard" href={href}>
    <div class="art">
      <slot name="art">
        {coverImage ? (
          <img
            src={coverImage}
            alt={title}
            loading="lazy"
            class="journal-cover-img"
            onerror="this.onerror=null; this.src='/images/brand/logo.svg';"
          />
        ) : (
          <svg viewBox="0 0 300 132" preserveAspectRatio="none" aria-hidden="true">
            <rect width="300" height="132" fill="#EAF5EC"/>
            <circle cx="80" cy="60" r="28" fill="#4FAE6F"/>
            <circle cx="150" cy="52" r="34" fill="#3E9B5F"/>
            <circle cx="216" cy="64" r="26" fill="#2F8A50"/>
            <rect x="0" y="104" width="300" height="28" fill="#CFE3D5"/>
          </svg>
        )}
      </slot>
      <div class="edu-cover-badges">
        <span class="edu-badge-pill pill-soft">{badge}</span>
      </div>
    </div>
    <div class="body">
      <h3>{title}</h3>
      {source && <div class="src">{source}</div>}
      <div class="foot">
        <span></span>
        <span class="read">Baca Artikel →</span>
      </div>
    </div>
  </a>
) : (
  <article class="edu-card card" data-topic={topic.toLowerCase()} data-id={id}>
    {coverImage && (
      <div class="edu-cover-wrap">
        <img
          src={coverImage}
          alt={title}
          loading="lazy"
          class="edu-cover-img"
          onerror="this.onerror=null; this.src='/images/brand/logo.svg';"
        />
        <div class="edu-cover-overlay"></div>
        <!-- Badges on top of cover image with horizontal flex alignment -->
        <div class="edu-cover-badges">
          <span class="edu-badge-pill pill-topic">{topic}</span>
          <span class="edu-badge-pill pill-type">{type}</span>
        </div>
      </div>
    )}

    <div class="edu-card-inner">
      <div class="edu-head">
        <div class="edu-icon-wrap" aria-hidden="true">
          <span class="edu-icon">{icon}</span>
        </div>
        {!coverImage && (
          <div class="edu-badges">
            <span class="edu-badge-pill pill-topic">{topic}</span>
            <span class="edu-badge-pill pill-type">{type}</span>
          </div>
        )}
      </div>

      <div class="edu-body">
        <h3 class="edu-title">{title}</h3>
        <p class="edu-desc">{description}</p>

        {highlights && highlights.length > 0 && (
          <details class="edu-details lesson">
            <summary class="edu-summary">
              <span>Lihat Poin Pembahasan ({highlights.length})</span>
            </summary>
            <ul class="edu-highlights-list">
              {highlights.map((item) => (
                <li>
                  <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor" width="15" height="15" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>

      <div class="edu-footer">
        <div class="edu-meta">
          <span class="meta-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            {pagesCount} Halaman
          </span>
          <span class="meta-sep">•</span>
          <span class="meta-item">{fileSize}</span>
        </div>

        <div class="edu-actions">
          {pdfUrl && (
            <a
              class="btn btn-download"
              href={encodedPdfUrl}
              download={effectiveDownloadName}
              title={`Unduh file ${effectiveDownloadName}`}
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Unduh PDF</span>
            </a>
          )}
          {pdfUrl && (
            <a
              class="btn-preview-link"
              href={encodedPdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              title="Buka PDF di tab baru"
            >
              Buka ↗
            </a>
          )}
        </div>
      </div>
    </div>
  </article>
)}

<style>
  .edu-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1.5px solid var(--line, #D1E5D5);
    border-radius: 18px;
    overflow: hidden;
    padding: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
    box-shadow: 0 4px 16px rgba(14, 58, 33, 0.05);
  }

  .edu-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(14, 58, 33, 0.11);
    border-color: #3E9B5F;
  }

  .edu-cover-wrap {
    position: relative;
    width: 100%;
    height: 154px;
    background: var(--g50, #eaf5ec);
    overflow: hidden;
  }

  .edu-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
    display: block;
  }

  .edu-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0) 50%, rgba(0,0,0,0.1) 100%);
    pointer-events: none;
  }

  .edu-card:hover .edu-cover-img {
    transform: scale(1.05);
  }

  /* Horizontal Flex Badge Container (Never overlapping) */
  .edu-cover-badges {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    z-index: 3;
    pointer-events: none;
  }

  .edu-badges {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
  }

  .edu-badge-pill {
    position: static !important;
    top: auto !important;
    left: auto !important;
    display: inline-flex !important;
    align-items: center !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    padding: 4px 10px !important;
    border-radius: 100px !important;
    line-height: 1.3 !important;
    white-space: nowrap !important;
    text-shadow: none !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important;
    pointer-events: auto !important;
  }

  .pill-topic {
    background: var(--g700, #1B6B3A) !important;
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
  }

  .pill-type {
    background: rgba(255, 255, 255, 0.95) !important;
    color: var(--g900, #0E3A21) !important;
    border: 1px solid rgba(27, 107, 58, 0.2) !important;
    backdrop-filter: blur(4px) !important;
  }

  .pill-soft {
    background: rgba(255, 255, 255, 0.95) !important;
    color: var(--g800, #134D2A) !important;
    border: 1px solid rgba(27, 107, 58, 0.2) !important;
  }

  .edu-card-inner {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .journal-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .edu-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
  }

  .edu-icon-wrap {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--g50, #EEF8F1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1px rgba(79, 174, 111, 0.2);
  }

  .edu-icon {
    font-size: 22px;
    line-height: 1;
  }

  .edu-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  .edu-title {
    font-size: 1.12rem;
    font-weight: 800;
    color: var(--g900, #0E3A21);
    line-height: 1.35;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .edu-desc {
    font-size: 0.9rem;
    color: var(--muted, #4A6353);
    line-height: 1.55;
    margin-bottom: 16px;
  }

  .edu-details {
    margin-top: auto;
    margin-bottom: 16px;
    background: #F8FCF9;
    border: 1px solid rgba(27, 107, 58, 0.15);
    border-radius: 10px;
    padding: 10px 14px;
  }

  .edu-summary {
    cursor: pointer;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--g700, #1B6B3A);
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .edu-summary:hover {
    color: var(--pink, #E5588E);
  }

  .edu-highlights-list {
    list-style: none;
    margin: 10px 0 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .edu-highlights-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.83rem;
    color: #31423A;
    line-height: 1.45;
  }

  .check-icon {
    color: var(--g500, #3E9B5F);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .edu-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line, #D1E5D5);
    margin-top: auto;
    flex-wrap: wrap;
  }

  .edu-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #4A6353;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .meta-sep {
    opacity: 0.5;
  }

  .edu-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--g700, #1B6B3A);
    color: #ffffff !important;
    padding: 7px 14px;
    border-radius: 100px;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .btn-download:hover {
    background: var(--g900, #0E3A21);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(27, 107, 58, 0.25);
  }

  .btn-preview-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: #4A6353;
    padding: 6px 8px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }

  .btn-preview-link:hover {
    color: var(--g700, #1B6B3A);
    background: #EEF8F1;
  }
</style>
