---
interface Props {
  title?: string;
  description?: string;
  phone?: string;
  phoneDisplay?: string;
  whatsappUrl?: string;
  email?: string;
  instagramUrl?: string;
  formUrl?: string;
  isEn?: boolean;
}

const {
  isEn = false,
  title = isEn ? 'Environmental reporting hotline' : 'Hotline Pelaporan Pelanggaran Kerusakan Lingkungan',
  description = isEn
    ? 'If you find environmental damage, report it immediately. Include photos and location to speed up follow-up.'
    : 'Laporkan jika kamu menemukan aktivitas yang merusak lingkungan di sekitarmu. Sertakan foto dan titik lokasi supaya lebih cepat ditindaklanjuti.',
  phone = '+6288127371159',
  phoneDisplay = '0881-273-71159',
  whatsappUrl = 'https://wa.me/6288127371159?text=Halo%20Cangkruk%20Hijau%2C%20saya%20ingin%20mengajukan%20pengaduan%20lingkungan.',
  email = 'mailto:CangkrukHijau@gmail.com',
  instagramUrl = 'https://www.instagram.com/CangkrukHijau_id/',
  formUrl = '/laporan',
} = Astro.props;
---

<section id={isEn ? "report" : "laporan"}>
  <div class="wrap">
    <div class="hotline">
      <h2>{title}</h2>
      <p>{description}</p>
      <a class="phone" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        {phoneDisplay}
      </a>
      <div class="kanal">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          <span class="ic">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-4-4.6-4.2-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.1c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .6l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.2 1.4 2.5 1.5.2.1.4 0 .5-.1l.8-.9c.2-.2.4-.2.6-.1l2 .9c.2.1.4.2.4.3.1.2.1.8-.1 1.4Z"/>
            </svg>
          </span>
          WhatsApp
        </a>
        <a href={`tel:${phone}`}>
          <span class="ic">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1Z"/>
            </svg>
          </span>
          {isEn ? 'Phone' : 'Telepon'}
        </a>
        <a href={email} target="_blank" rel="noopener noreferrer">
          <span class="ic">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 5h18v14H3Zm2 2.4V17h14V7.4l-7 4.6Zm.9-.4 6.1 4 6.1-4Z"/>
            </svg>
          </span>
          Email
        </a>
        <a href={instagramUrl} target="_blank" rel="noopener noreferrer">
          <span class="ic">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm5 5.2A4.8 4.8 0 1 0 16.8 12 4.8 4.8 0 0 0 12 7.2Zm0 2A2.8 2.8 0 1 1 9.2 12 2.8 2.8 0 0 1 12 9.2ZM17.6 6a1.2 1.2 0 1 0 1.2 1.2A1.2 1.2 0 0 0 17.6 6Z"/>
            </svg>
          </span>
          Instagram
        </a>
        <a href={formUrl}>
          <span class="ic">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6 2h8l4 4v16H6Zm8 1.5V7h3.5ZM8.5 11h7v1.8h-7Zm0 3.4h7v1.8h-7Z"/>
            </svg>
          </span>
          {isEn ? 'Report Form' : 'Form Laporan'}
        </a>
      </div>
    </div>
  </div>
</section>
