---
interface Props {
  title?: string;
  description?: string;
  isEn?: boolean;
}

const {
  isEn = false,
  title = isEn ? 'Official Surabaya Environmental Reporting Hotline' : 'Hotline Resmi Pengaduan Lingkungan Hidup Kota Surabaya',
  description = isEn
    ? 'Report environmental violations, illegal waste dumping, fallen trees, or river pollution directly to DLH Surabaya and Emergency 112.'
    : 'Laporkan pelanggaran lingkungan, pembuangan limbah liar, pohon tumbang, atau pencemaran air secara cepat ke Dinas Lingkungan Hidup (DLH) Kota Surabaya dan Call Center 112.',
} = Astro.props;

const dlhWhatsappUrl = 'https://wa.me/628113112255?text=Halo%20Dinas%20Lingkungan%20Hidup%20Kota%20Surabaya%2C%20saya%20ingin%20melaporkan%20pengaduan%20lingkungan.';
---

<section id={isEn ? "report" : "laporan"}>
  <div class="wrap">
    <div class="hotline">
      <div class="hotline-badge">
        <span>🚨 HOTLINE & TANGGAP DARURAT RESMI</span>
      </div>
      <h2>{title}</h2>
      <p>{description}</p>

      <!-- Nomor Utama WA & 112 -->
      <div class="hotline-main-buttons">
        <a class="phone" href={dlhWhatsappUrl} target="_blank" rel="noopener noreferrer" title="Chat WhatsApp Resmi DLH Surabaya">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-4-4.6-4.2-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.1c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .6l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.2 1.4 2.5 1.5.2.1.4 0 .5-.1l.8-.9c.2-.2.4-.2.6-.1l2 .9c.2.1.4.2.4.3.1.2.1.8-.1 1.4Z"/>
          </svg>
          WA DLH: 0811-3112-255
        </a>
        <a class="phone phone-112" href="tel:112" title="Panggilan Darurat Bebas Pulsa Surabaya 112">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1Z"/>
          </svg>
          Darurat 112 (Bebas Pulsa)
        </a>
      </div>

      <div class="kanal">
        <a href={dlhWhatsappUrl} target="_blank" rel="noopener noreferrer">
          <span class="ic">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-4-4.6-4.2-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.1c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .6l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.2 1.4 2.5 1.5.2.1.4 0 .5-.1l.8-.9c.2-.2.4-.2.6-.1l2 .9c.2.1.4.2.4.3.1.2.1.8-.1 1.4Z"/>
            </svg>
          </span>
          WhatsApp DLH
        </a>
        <a href="tel:112">
          <span class="ic">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1Z"/>
            </svg>
          </span>
          Call Center 112
        </a>
        <a href="mailto:dlh@surabaya.go.id" target="_blank" rel="noopener noreferrer">
          <span class="ic">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 5h18v14H3Zm2 2.4V17h14V7.4l-7 4.6Zm.9-.4 6.1 4 6.1-4Z"/>
            </svg>
          </span>
          dlh@surabaya.go.id
        </a>
        <a href="https://www.instagram.com/dlhsurabaya/" target="_blank" rel="noopener noreferrer">
          <span class="ic">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm5 5.2A4.8 4.8 0 1 0 16.8 12 4.8 4.8 0 0 0 12 7.2Zm0 2A2.8 2.8 0 1 1 9.2 12 2.8 2.8 0 0 1 12 9.2ZM17.6 6a1.2 1.2 0 1 0 1.2 1.2A1.2 1.2 0 0 0 17.6 6Z"/>
            </svg>
          </span>
          Instagram @dlhsurabaya
        </a>
        <a href="/laporan">
          <span class="ic">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6 2h8l4 4v16H6Zm8 1.5V7h3.5ZM8.5 11h7v1.8h-7Zm0 3.4h7v1.8h-7Z"/>
            </svg>
          </span>
          {isEn ? 'Reporting Form' : 'Form Pengaduan Warga'}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hotline-badge {
    margin-bottom: 12px;
  }
  .hotline-badge span {
    background: #E02424;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 100px;
    display: inline-block;
  }
  .hotline-main-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 22px 0 16px;
  }
  .phone-112 {
    background: linear-gradient(135deg, #E02424 0%, #9B1C1C 100%) !important;
  }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
</style>
